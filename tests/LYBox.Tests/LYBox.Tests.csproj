<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.76.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- 现有测试（SettingsService/PluginUtilities/PluginLoader）仅依赖 Layout.Core，
         不需要 Layout.Ursa（其 ApplicationViewModel 引用了不存在的 LYBox.UI 命名空间，
         是仓库预存的构建问题）。故直接引用 Layout.Core 以解耦。 -->
    <ProjectReference Include="..\..\src\Layout\LYBox.Layout.Core\LYBox.Layout.Core.csproj" />
    <!-- WebViewIpcHost / WebHostService 位于 LYBox.Plugin.Shared.Web 包（S3 拆分），测试直接引用。 -->
    <ProjectReference Include="..\..\src\Plugin\LYBox.Plugin.Shared\LYBox.Plugin.Shared.csproj" />
    <ProjectReference Include="..\..\src\Plugin\LYBox.Plugin.Shared.Web\LYBox.Plugin.Shared.Web.csproj" />
    <!-- 控制台 CLI 单元测试（S4）：IPluginCommandRegistrar 与插件命令注册逻辑 -->
    <ProjectReference Include="..\..\src\App\LYBox.Launcher.Console\LYBox.Launcher.Console.csproj" />
  </ItemGroup>

</Project>
