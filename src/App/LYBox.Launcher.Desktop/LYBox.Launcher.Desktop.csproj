<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Satori GC（实验性替代 GC，由 hez2010 维护）：
    仅在 self-contained 发布（CoreCLR 自包含 / NativeAOT）时生效，框架依赖运行与常规构建不受影响。
    版本必须与应用的 .NET 主版本一致（net10.0 → 10.0.x-satori.*）；如需回退原生运行时，发布时加 -p:UseSatoriGC=false。
    该属性需在评估期解析，无法走 Directory.Packages.props 变量，故此处直接内联版本号。
  -->
  <Sdk Name="PublishWithSatoriGC" Version="10.0.14-satori.40433706833.1" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ApplicationIcon>..\..\Layout\LYBox.Layout.Ursa\Assets\lybox.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="Models\**" />
    <Compile Remove="Models\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Models\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDI)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="$(AvaloniaDiagnosticsSupport)" />
  </ItemGroup>

  <!--
    ASP.NET Core 共享框架引用：让宿主运行时能加载 Kestrel（WebHostService 依赖）。
    使用 FrameworkReference 而非 Microsoft.NET.Sdk.Web 是为了保留 WinExe 输出类型
    与现有的 Avalonia 桌面应用发布配置不变。
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Layout\LYBox.Layout.Ursa\LYBox.Layout.Ursa.csproj" />
    <ProjectReference Include="..\..\Plugin\LYBox.Plugin.Shared\LYBox.Plugin.Shared.csproj" />
    <!-- S3：App.axaml.cs 直接使用 WebHostService（Web 包），显式引用避免依赖宿主传递顺序 -->
    <ProjectReference Include="..\..\Plugin\LYBox.Plugin.Shared.Web\LYBox.Plugin.Shared.Web.csproj" />
  </ItemGroup>

</Project>
