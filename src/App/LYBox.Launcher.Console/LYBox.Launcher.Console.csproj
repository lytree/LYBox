<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ApplicationIcon>..\..\Layout\LYBox.Layout.Ursa\Assets\lybox.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复用 GUI 版启动逻辑（App / AppBuilder / DI / 插件加载），仅入口输出类型不同 -->
    <ProjectReference Include="..\LYBox.Launcher.Desktop\LYBox.Launcher.Desktop.csproj" />
    <!-- CLI contracts are split from the core Shared SDK; the host still supplies their runtime dependencies. -->
    <ProjectReference Include="..\..\Plugin\LYBox.Plugin.CommandLine\LYBox.Plugin.CommandLine.csproj" />
    <ProjectReference Include="..\..\Plugin\LYBox.Plugin.Shared\LYBox.Plugin.Shared.csproj" />
    <ProjectReference Include="..\..\Layout\LYBox.Layout.Core\LYBox.Layout.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="$(SystemCommandLineVersion)" />
    <PackageReference Include="Spectre.Console" Version="$(SpectreConsoleVersion)" />
  </ItemGroup>

  <!-- 测试可见性（S4）：PluginCommandRegistry / ConsoleApplication 的 internal 成员需对 LYBox.Tests 可见 -->
  <ItemGroup>
    <InternalsVisibleTo Include="LYBox.Tests" />
  </ItemGroup>
</Project>
