<Styles
    x:Class="LYBox.Layout.Ursa.Theme.FluentDesign.FluentDesignStyles"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa">

    <!-- ============================================================
         Fluent Design System — WinUI 3 风格样式
         所有样式统一使用 Fluent* 前缀，遵循 WinUI 3 语义色彩 token。
         组件选型原则：优先 Irihi.Ursa 组件，缺失项用以下样式补充。
         ============================================================ -->

    <!-- ===== 布局辅助样式（卡片、导航面板、标题栏、页面头部） ===== -->

    <!-- 简单卡片 (Border) — 用于一般内容容器 -->
    <Style Selector="Border.FluentCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #0F000000" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Border.FluentCard:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #1A000000" />
    </Style>

    <!-- 可点击卡片 (Button) — 带 hover/press 反馈 -->
    <Style Selector="Button.FluentCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.FluentCard:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
    </Style>
    <Style Selector="Button.FluentCard:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>

    <!-- 导航面板背景层 (Border) — 左侧导航区域（WinUI NavigationView Pane 背景） -->
    <Style Selector="Border.FluentNavPane">
        <Setter Property="Background" Value="{DynamicResource FluentNavPaneBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BoxShadow" Value="{DynamicResource FluentPaneBoxShadow}" />
    </Style>

    <!-- 主内容表面 (Border) — 与侧边栏贴合的扁平内容区（工具坞布局：无圆角、无外边距），
         不使用阴影/描边，仅靠底色层级区分侧边栏与内容 -->
    <Style Selector="Border.FluentMainContentSurface">
        <Setter Property="Background" Value="{DynamicResource FluentPageBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BoxShadow" Value="{DynamicResource FluentPaneBoxShadow}" />
    </Style>

    <!-- ===== 顶部菜单栏 (Menu) — Win11 菜单条：透明背景、紧凑行高 ===== -->
    <!-- 用法：<Menu Classes="FluentMenuBar"><MenuItem Header="文件">…</MenuItem></Menu> -->
    <Style Selector="Menu.FluentMenuBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="Menu.FluentMenuBar > MenuItem">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== 命令栏 (CommandBar) ===== -->
    <!-- 组件本体为 Controls/FluentCommandBar（Button/ToggleButton 组合），
         卡片化外壳与按钮态样式内置于该控件，这里不再重复定义。 -->

    <!-- 标题栏 (Border) — 顶部应用标题区域（与导航面板同层色，视觉一致） -->
    <Style Selector="Border.FluentTitleBar">
        <Setter Property="Background" Value="{DynamicResource FluentTitleBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentShellTitleBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,16,0" />
        <Setter Property="MinHeight" Value="{DynamicResource FluentTitleBarHeight}" />
    </Style>

    <!-- 工具栏容器 (Border) — 自绘标题栏下方的汉堡/搜索/操作行 -->
    <Style Selector="Border.FluentToolbar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,16,0" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <!-- 工具栏按钮 (Button) — 顶部操作行按钮；加 .accent 变体为主操作按钮 -->
    <Style Selector="Button.FluentToolbarButton">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="Button.FluentToolbarButton.accent">
        <Setter Property="Background" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.FluentToolbarButton.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentAccentPointeroverBrush}" />
    </Style>
    <Style Selector="Button.FluentToolbarButton.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentAccentPressedBrush}" />
    </Style>

    <!-- 小型按钮 (Button) — 紧凑尺寸动作按钮 -->
    <Style Selector="Button.FluentSmall">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- 页面头部容器 (StackPanel) — 标题 + 描述组合 -->
    <Style Selector="StackPanel.FluentPageHeader">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="Spacing" Value="4" />
    </Style>

    <!-- ===== 排版样式（标题、副标题、正文、说明文字） ===== -->

    <!-- 区块标题 — 20px SemiBold -->
    <Style Selector="TextBlock.FluentSectionHeader">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
        <Setter Property="Margin" Value="0,24,0,12" />
    </Style>

    <!-- 页面大标题 — 28px SemiBold -->
    <Style Selector="TextBlock.FluentLargeTitle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
    </Style>

    <!-- 页面描述 — 14px 次级文字 -->
    <Style Selector="TextBlock.FluentPageDescription">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText2}" />
    </Style>

    <!-- 卡片标题 — 16px SemiBold -->
    <Style Selector="TextBlock.FluentSubtitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
    </Style>

    <!-- 正文 — 14px 主文字 -->
    <Style Selector="TextBlock.FluentBody">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText1}" />
    </Style>

    <!-- 辅助说明文字 — 12px 三级文字 -->
    <Style Selector="TextBlock.FluentCaption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText2}" />
    </Style>

    <!-- ===== 导航项按钮（WinUI NavViewItem 风格） ===== -->

    <!-- 导航项 — 透明背景 + hover 反馈 -->
    <Style Selector="Button.FluentNavItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Button.FluentNavItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.FluentNavItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>

    <!-- 搜索框 — 圆角输入框，导航栏内嵌（WinUI AutoSuggestBox 风格）。
         默认/悬浮用 CardStroke 边框，聚焦时切换为 accent 2px 边框，
         内边距同步收缩 1px（12->11 / 7->6）以抵消边框增厚，避免内容跳动。 -->
    <Style Selector="TextBox.FluentSearchBox">
        <Setter Property="Background" Value="{DynamicResource FluentSearchBoxBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="TextBox.FluentSearchBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentColorBorder}" />
    </Style>
    <Style Selector="TextBox.FluentSearchBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="11,6" />
    </Style>

    <!-- 搜索框内嵌动作按钮（清除 / 搜索）：22x22 透明按钮，常驻在输入框右侧。
         搜索按钮不随输入显隐，保证「搜索时」仍然可点；清除按钮只在其左侧出现。 -->
    <Style Selector="Button.FluentSearchActionButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentSearchActionButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.FluentSearchActionButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>

    <!-- ===== 工具坞布局（参考 DevToys 布局结构，配色仍走 Fluent 令牌） ===== -->

    <!-- 侧边栏顶部图标按钮（汉堡/返回）— 32x32 透明按钮 -->
    <Style Selector="Button.FluentRailButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentRailButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.FluentRailButton:pressed">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>
    <Style Selector="Button.FluentRailButton:disabled">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- 首页头图区（Banner）— 全宽通栏，品牌渐变 + 左上/右上小圆角。
         左右内边距与卡片网格的 24px 外边距对齐，保证标题与卡片左边缘同一条竖线。 -->
    <Style Selector="Border.FluentHeroBanner">
        <Setter Property="Background" Value="{DynamicResource FluentHeroGradientBrush}" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="MinHeight" Value="90" />
        <Setter Property="CornerRadius" Value="4,4,0,0" />
    </Style>
    <!-- 头图主标题 — 30px Bold（品牌底色上恒为白字） -->
    <Style Selector="TextBlock.FluentHeroTitle">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentHeroTitleForeground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 头图版本后缀 — 主标题右侧基线对齐 -->
    <Style Selector="TextBlock.FluentHeroVersion">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource FluentHeroTitleForeground}" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <!-- 工具卡片（Button）— 左侧图标方块 + 右侧标题/描述，三列网格使用 -->
    <Style Selector="Button.FluentToolCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Height" Value="96" />
        <!-- 卡片必须撑满所在网格列：UniformGrid 给的是单元格尺寸，
             卡片自身不拉伸就会按内容宽度收缩（表现为卡片挤在列左侧）。 -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentToolCard:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.FluentToolCard:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>

    <!-- 工具卡片左侧图标方块 -->
    <Style Selector="Border.FluentToolIconTile">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource FluentIconTileBackgroundBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.FluentToolCardTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.FluentToolCardDescription">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- 汉堡菜单按钮 — 40x40 透明按钮（WinUI 标准标题栏按钮尺寸，光标反馈 Subtle） -->
    <Style Selector="Button.FluentHamburger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentHamburger:pointerover">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.FluentHamburger:pressed">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>
    <!-- 返回按钮无历史可回时置灰但仍占位，避免汉堡按钮左右跳动 -->
    <Style Selector="Button.FluentHamburger:disabled">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- 导航面板折叠按钮 — 底部导航切换 -->
    <Style Selector="Button.FluentNavToggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentNavToggle:pointerover">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.FluentNavToggle:pressed">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>

    <!-- 导航页脚按钮 (Button) — 页面底部系统入口（设置/插件管理），默认次级色，hover 提亮 -->
    <Style Selector="Button.FluentNavFooterItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource FluentTextSecondaryBrush}" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentNavFooterItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.FluentNavFooterItem:pressed">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>

    <!-- ===== Ursa NavMenuItem Fluent 风格覆盖 ===== -->

    <!-- NavMenuItem: 选中项 accent-tint 背景 + 左侧 accent 指示竖条（WinUI NavigationViewItem 选中态） -->
    <Style Selector="u|NavMenuItem:selected /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource FluentNavItemSelectedBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="u|NavMenuItem:selected:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource FluentNavItemSelectedHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="u|NavMenuItem:selected:focus /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource FluentNavItemSelectedBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>

    <!-- NavMenuItem: 选中图标 accent 色 -->
    <Style Selector="u|NavMenuItem:selected /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Foreground" Value="{DynamicResource FluentAccentBrush}" />
    </Style>

    <!-- NavMenuItem: 选中文字 accent 色 + 半粗体（WinUI AccentTextFillColorPrimary 选中强调） -->
    <Style Selector="u|NavMenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource FluentAccentBrush}" />
    </Style>
    <Style Selector="u|NavMenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- NavMenuItem: hover 微妙背景 -->
    <Style Selector="u|NavMenuItem /template/ Border#PART_Border:pointerover">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>

    <!-- NavMenuItem: 图标位置一致（折叠/展开均左对齐） -->
    <Style Selector="u|NavMenuItem:first-level /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Padding" Value="14,8,8,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="u|NavMenuItem:horizontal-collapsed:first-level /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Grid.ColumnSpan" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="14,8,8,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- NavMenuItem: 仅一级菜单显示图标，子菜单项隐藏 -->
    <Style Selector="u|NavMenuItem:not(:first-level) /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ============================================================
         以下为 Ursa 未提供的 WinUI 3 补充控件样式
         ============================================================ -->

    <!-- ===== SettingsExpander / SettingCard（WinUI SettingsExpander 风格） ===== -->
    <!-- 用于设置页：左图标 + 标题/描述 + 右内容（开关/按钮） -->
    <Style Selector="Border.FluentSettingsCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Border.FluentSettingsCard:pointerover">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="Border.FluentSettingsCard:pressed">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>

    <!-- 可点击的 SettingsCard（包装在 Button 上） -->
    <Style Selector="Button.FluentSettingsCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.FluentSettingsCard:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
    </Style>
    <Style Selector="Button.FluentSettingsCard:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>

    <!-- SettingsCard 标题（左主标题） -->
    <Style Selector="TextBlock.FluentSettingsCardTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
    </Style>
    <!-- SettingsCard 描述（左副标题） -->
    <Style Selector="TextBlock.FluentSettingsCardDescription">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText2}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <!-- SettingsCard Header 图标（左侧 IconPresenter） -->
    <Style Selector="Border.FluentSettingsCardIconHost">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource FluentSubtleBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== InfoBadge（WinUI InfoBadge 小徽章） ===== -->
    <!-- 用于导航项/列表项的数值或状态徽章 -->
    <Style Selector="Border.FluentInfoBadge">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Background" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.FluentInfoBadge.FluentInfoBadgeCritical">
        <Setter Property="Background" Value="{DynamicResource FluentColorDanger}" />
    </Style>
    <Style Selector="Border.FluentInfoBadge.FluentInfoBadgeWarning">
        <Setter Property="Background" Value="{DynamicResource FluentColorWarning}" />
    </Style>
    <Style Selector="Border.FluentInfoBadge.FluentInfoBadgeInformational">
        <Setter Property="Background" Value="{DynamicResource FluentAccentBrush}" />
    </Style>
    <Style Selector="Border.FluentInfoBadge.FluentInfoBadgeSuccess">
        <Setter Property="Background" Value="{DynamicResource FluentColorSuccess}" />
    </Style>
    <!-- InfoBadge 内文字 -->
    <Style Selector="TextBlock.FluentInfoBadgeText">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <!-- 点状徽章（Dot 形式，不带数字） -->
    <Style Selector="Ellipse.FluentInfoBadgeDot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 状态徽章 (Label) — 列表项/表格单元格的状态标记（WinUI StatusBadge 风格） -->
    <Style Selector="Label.FluentStatusBadge">
        <Setter Property="Background" Value="{DynamicResource FluentColorPrimaryLight}" />
        <Setter Property="Foreground" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===== ProgressRing（WinUI 圆环进度指示器） ===== -->
    <!-- Irihi.Ursa 有 Loading（线性+点状），但缺少确定性圆环。
         用法：<ProgressBar Classes="circular FluentProgressRing" /> 或 indeterminate 时
              <ProgressBar Classes="circular FluentProgressRing" IsIndeterminate="True" /> -->
    <Style Selector="ProgressBar.circular.FluentProgressRing">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>
    <Style Selector="ProgressBar.FluentProgressRing.Small">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="ProgressBar.FluentProgressRing.Large">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
    </Style>

    <!-- ===== BreadcrumbBar（WinUI 面包屑导航） ===== -->
    <!-- Irihi.Ursa 有 Breadcrumb 控件但样式偏旧版，此处提供 Fluent 风格的项样式（应用于 Button） -->
    <Style Selector="Button.FluentBreadcrumbItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText1}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.FluentBreadcrumbItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource FluentAccentBrush}" />
    </Style>
    <Style Selector="Button.FluentBreadcrumbItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>
    <!-- 当前（最后）节点：禁用样式 + 高亮色 -->
    <Style Selector="TextBlock.FluentBreadcrumbCurrent">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
    </Style>
    <!-- 分隔符（>） -->
    <Style Selector="TextBlock.FluentBreadcrumbSeparator">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText2}" />
        <Setter Property="Margin" Value="2,0" />
    </Style>

    <!-- ===== ContentDialog（WinUI 内容对话框） ===== -->
    <!-- Irihi.Ursa 的 Dialog/Drawer 适合通用面板；ContentDialog 提供模态对话框（标题+内容+按钮组）。
         此处仅提供外层 Border + 按钮组的 Fluent 风格样式，控件仍走 Ursa Dialog API。 -->
    <Style Selector="Border.FluentContentDialogSurface">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="MinWidth" Value="320" />
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="BoxShadow" Value="0 8 32 0 #33000000" />
    </Style>
    <Style Selector="TextBlock.FluentContentDialogTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.FluentContentDialogBody">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText1}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <!-- 按钮组容器 -->
    <Style Selector="StackPanel.FluentContentDialogButtonRow">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <!-- ===== NumberBox 边框一致性（Irihi.Ursa NumericUpDown 的 Fluent 微调） ===== -->
    <!-- 让 Ursa NumericUpDown 在 hover/focus 时与 Fluent 输入控件一致 -->
    <Style Selector="u|NumericUpDown.FluentNumeric /template/ Border#PART_RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
    </Style>
    <Style Selector="u|NumericUpDown.FluentNumeric:focus /template/ Border#PART_RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ===== TagInput Fluent 微调（Ursa 已有控件，仅统一边框） ===== -->
    <Style Selector="u|TagInput.FluentTagInput /template/ Border#PART_RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
    </Style>
    <Style Selector="u|TagInput.FluentTagInput:focus /template/ Border#PART_RootBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
    </Style>

    <!-- ============================================================
         Avalonia-Fluent-UI inspired primary control styles
         使用 WinUI 3 语义颜色 token，提供 Accent/Standard/Hypertext
         按钮、ElevatedCard、HeaderedCard、Divider、Smoke overlay 等
         ============================================================ -->

    <!-- ===== Accent Button（WinUI 3 AccentButton 风格） ===== -->
    <!-- 背景使用 AccentFillColor 系列 token，文字使用 TextOnAccent。
         用法：<Button Classes="FluentAccent">Primary Action</Button> -->
    <Style Selector="Button.FluentAccent">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ButtonBorderThemeThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentAccent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.FluentAccent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Button.FluentAccent:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
    </Style>

    <!-- ===== Standard Outline Button（WinUI 3 默认 Button 风格） ===== -->
    <!-- 背景使用 ControlFillColorDefault，边框使用 ControlElevationBorder。
         用法：<Button Classes="FluentStandard">Secondary Action</Button> -->
    <Style Selector="Button.FluentStandard">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ButtonBorderThemeThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.143" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentStandard:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
    </Style>
    <Style Selector="Button.FluentStandard:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>
    <Style Selector="Button.FluentStandard:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
    </Style>

    <!-- ===== Subtle/Transparent Button（hover-only background） ===== -->
    <!-- 用法：<Button Classes="FluentSubtle">Ghost Action</Button> -->
    <Style Selector="Button.FluentSubtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentSubtle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.FluentSubtle:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Button.FluentSubtle:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
    </Style>

    <!-- ===== Hypertext Button（链接/文字按钮） ===== -->
    <!-- 用法：<Button Classes="FluentHypertext">Click here</Button> -->
    <Style Selector="Button.FluentHypertext">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentHypertext:pointerover /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource FluentAccentPointeroverBrush}" />
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.FluentHypertext:pressed /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource FluentAccentPressedBrush}" />
    </Style>

    <!-- ===== Elevated Card（带阴影的卡片，用于关键内容/对话框） ===== -->
    <!-- 替代简单 Border 卡片，提供 WinUI Card 的 elevation 效果。
         用法：<Border Classes="FluentElevatedCard">...</Border> -->
    <Style Selector="Border.FluentElevatedCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #14000000, 0 8 16 0 #0A000000" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.143" />
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.143" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Border.FluentElevatedCard:pointerover">
        <Setter Property="BoxShadow" Value="0 4 16 0 #1E000000, 0 12 24 0 #0F000000" />
    </Style>

    <!-- ===== Headered Card（带标题分隔线的卡片） ===== -->
    <!-- 用法：
         <Border Classes="FluentHeaderedCard">
             <StackPanel>
                 <TextBlock Classes="FluentCardHeader" Text="Section Title" />
                 <Border Classes="FluentCardDivider" />
                 <ContentControl Content="{Binding ...}" />
             </StackPanel>
         </Border> -->
    <Style Selector="Border.FluentHeaderedCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
    </Style>
    <Style Selector="TextBlock.FluentCardHeader">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- Card 内分隔线（含上下间距） -->
    <Style Selector="Border.FluentCardDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ===== Divider（通用水平分隔线） ===== -->
    <!-- 使用语义 token。用法：<Border Classes="FluentDivider" /> -->
    <Style Selector="Border.FluentDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Margin" Value="0,8" />
    </Style>
    <!-- 垂直分隔线（较少见，但统一提供） -->
    <Style Selector="Border.FluentDividerVertical">
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Margin" Value="8,0" />
    </Style>

    <!-- ===== Smoke Overlay（模态遮罩） ===== -->
    <!-- 用于自定义 Dialog/Drawer 的遮罩层。用法：<Border Classes="FluentSmokeOverlay" /> -->
    <Style Selector="Border.FluentSmokeOverlay">
        <Setter Property="Background" Value="{DynamicResource SmokeFillColorDefaultBrush}" />
    </Style>

    <!-- ===== StatusBar（WinUI 底部状态栏补充样式） ===== -->
    <!-- 用法：
         <Border Classes="FluentStatusBar">
             <StackPanel Orientation="Horizontal" Spacing="16">
                 <TextBlock Classes="FluentStatusItem" Text="就绪" />
                 <Border Classes="FluentStatusBarSeparator" />
                 <TextBlock Classes="FluentStatusItemStrong" Text="插件：12" />
             </StackPanel>
         </Border> -->
    <Style Selector="Border.FluentStatusBar">
        <Setter Property="Background" Value="{DynamicResource FluentColorBackground1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentShellContentBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,0,24,0" />
    </Style>
    <!-- 状态文本项：次级文字，统一行高并垂直居中基线 -->
    <Style Selector="TextBlock.FluentStatusItem">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText2}" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 主状态项：SemiBold 强调，如"就绪" -->
    <Style Selector="TextBlock.FluentStatusItemStrong">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText1}" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 分隔竖线：语义化 Divider，与状态栏同层色对视 -->
    <Style Selector="Border.FluentStatusBarSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Background" Value="{DynamicResource FluentDividerBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ============================================================
         ===== 新增 Fluent 控件样式（参考 A-FUI 设计，纯样式实现） =====
         ============================================================ -->

    <!-- ===== FluentHyperlinkButton（WinUI HyperlinkButton 风格） ===== -->
    <!-- 用法：<Button Classes="FluentHyperlinkButton" Command="{Binding OpenLinkCommand}">点击跳转</Button>
         与 FluentHypertext 区别：FluentHyperlinkButton 是 WinUI 命名，并提供 focus 可见边框。 -->
    <Style Selector="Button.FluentHyperlinkButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.083" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.FluentHyperlinkButton:pointerover /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource FluentAccentPointeroverBrush}" />
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.FluentHyperlinkButton:pressed /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource FluentAccentPressedBrush}" />
    </Style>
    <Style Selector="Button.FluentHyperlinkButton:focus /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
    </Style>
    <Style Selector="Button.FluentHyperlinkButton:disabled /template/ ContentPresenter">
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
    </Style>

    <!-- ===== FluentInfoBar（WinUI InfoBar 风格 - 含严重级别 + 关闭按钮） ===== -->
    <!-- 用法：
         <Border Classes="FluentInfoBar FluentInfoBarSeverityInformational">
             <Grid ColumnDefinitions="Auto,*,Auto">
                 <PathIcon Grid.Column="0" Data="{DynamicResource FluentIcon20FilledInfo}" Width="20" Height="20"
                           Foreground="{DynamicResource FluentInfoBarInformationalIconBrush}" />
                 <StackPanel Grid.Column="1" Margin="12,0">
                     <TextBlock Classes="FluentInfoBarTitle" Text="标题" />
                     <TextBlock Classes="FluentInfoBarMessage" Text="消息内容" TextWrapping="Wrap" />
                 </StackPanel>
                 <Button Grid.Column="2" Classes="FluentInfoBarCloseButton" Click="..." />
             </Grid>
         </Border>
         严重级别修饰类：FluentInfoBarSeverityInformational / Warning / Success / Error -->
    <Style Selector="Border.FluentInfoBar">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 严重级别 - Informational（蓝色左边框 + 浅蓝背景） -->
    <Style Selector="Border.FluentInfoBar.FluentInfoBarSeverityInformational">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource FluentColorPrimaryLight}" />
    </Style>
    <!-- 严重级别 - Warning（橙黄左边框 + 浅黄背景） -->
    <Style Selector="Border.FluentInfoBar.FluentInfoBarSeverityWarning">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentColorWarning}" />
        <Setter Property="Background" Value="{DynamicResource FluentColorWarningLight}" />
    </Style>
    <!-- 严重级别 - Success（绿色左边框 + 浅绿背景） -->
    <Style Selector="Border.FluentInfoBar.FluentInfoBarSeveritySuccess">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentColorSuccess}" />
        <Setter Property="Background" Value="{DynamicResource FluentColorSuccessLight}" />
    </Style>
    <!-- 严重级别 - Error（红色左边框 + 浅红背景） -->
    <Style Selector="Border.FluentInfoBar.FluentInfoBarSeverityError">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentColorDanger}" />
        <Setter Property="Background" Value="{DynamicResource FluentColorDangerLight}" />
    </Style>
    <!-- InfoBar 标题 -->
    <Style Selector="TextBlock.FluentInfoBarTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <!-- InfoBar 消息内容 -->
    <Style Selector="TextBlock.FluentInfoBarMessage">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText1}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- InfoBar 关闭按钮（小尺寸透明按钮） -->
    <Style Selector="Button.FluentInfoBarCloseButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.FluentInfoBarCloseButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.FluentInfoBarCloseButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>

    <!-- ===== FluentSegmentedItem（WinUI Segmented 控件项样式） ===== -->
    <!-- 用法：
         <ListBox Classes="FluentSegmentedControl" SelectedIndex="{Binding SelectedOption}">
             <ListBoxItem Classes="FluentSegmentedItem">
                 <StackPanel Orientation="Horizontal" Spacing="8">
                     <PathIcon Data="{DynamicResource FluentIcon16RegularList}" Width="16" Height="16" />
                     <TextBlock Text="选项一" />
                 </StackPanel>
             </ListBoxItem>
             <ListBoxItem Classes="FluentSegmentedItem">...</ListBoxItem>
         </ListBox>
         容器样式：FluentSegmentedControl（横向布局 + 圆角外框）
         项样式：FluentSegmentedItem（选中态有 Accent 背景指示） -->
    <Style Selector="ListBox.FluentSegmentedControl">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem.FluentSegmentedItem">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem.FluentSegmentedItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem.FluentSegmentedItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>
    <Style Selector="ListBoxItem.FluentSegmentedItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBoxItem.FluentSegmentedItem:selected /template/ Border#PART_SelectedItemBorder">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ===== FluentSettingsExpander（WinUI SettingsExpander 风格） ===== -->
    <!-- 用法：
         <Expander Classes="FluentSettingsExpander">
             <Expander.Header>
                 <Grid ColumnDefinitions="Auto,*,Auto">
                     <Border Grid.Column="0" Classes="FluentSettingsCardIconHost">
                         <PathIcon Data="{DynamicResource FluentIcon24RegularSettings}" Width="20" Height="20" />
                     </Border>
                     <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                         <TextBlock Classes="FluentSettingsCardTitle" Text="设置项标题" />
                         <TextBlock Classes="FluentSettingsCardDescription" Text="副标题描述" />
                     </StackPanel>
                 </Grid>
             </Expander.Header>
             <Expander.Content>
                 <StackPanel Spacing="12" Margin="0,8,0,0">
                     <TextBlock Classes="FluentBody" Text="展开后的内容..." />
                 </StackPanel>
             </Expander.Content>
         </Expander> -->
    <Style Selector="Expander.FluentSettingsExpander">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Expander.FluentSettingsExpander:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
    </Style>
    <!-- Expander Header 区域内边距 -->
    <Style Selector="Expander.FluentSettingsExpander /template/ ToggleButton#PART_ExpanderHeader">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="56" />
    </Style>
    <!-- Expander Content 区域内边距 + 顶部分隔线 -->
    <Style Selector="Expander.FluentSettingsExpander /template/ ContentPresenter#PART_ExpanderContentPresenter">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- ============================================================
         插件页面外壳（PluginPage/PluginPageHeader/PluginCommandCard/
         PluginDataCard/DataCard）— 统一插件内容区域外观
         ============================================================ -->

    <!-- 插件页面容器 (Grid) — 页面级 margin -->
    <Style Selector="Grid.FluentPluginPage">
        <Setter Property="Margin" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- 插件页面头部 (StackPanel) — 标题 + 操作行组合 -->
    <Style Selector="StackPanel.FluentPluginPageHeader">
        <Setter Property="Spacing" Value="4" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- 插件命令卡片 (Border) — 命令/操作区域容器 -->
    <Style Selector="Border.FluentPluginCommandCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #0A000000" />
    </Style>

    <!-- 插件数据卡片 (Border) — 数据展示/列表容器 -->
    <Style Selector="Border.FluentPluginDataCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #0A000000" />
    </Style>

    <!-- 通用数据卡片 (Border) — 比 PluginDataCard 更轻量的表格区域卡片 -->
    <Style Selector="Border.FluentDataCard">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #0A000000" />
    </Style>

    <!-- ============================================================
         WinUI 3 控件补充样式（ComboBox / ListViewItem / ToolTip /
         ContextMenu / MenuItem / TabView）— 对齐 WinUI 3 控件规格：
         控件圆角 4px、弹层圆角 8px、Subtle hover、Accent 选中态
         ============================================================ -->

    <!-- ===== FluentComboBox（WinUI 3 ComboBox 风格） ===== -->
    <Style Selector="ComboBox.FluentComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="ComboBox.FluentComboBox:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentPointeroverBrush}" />
    </Style>
    <Style Selector="ComboBox.FluentComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
    </Style>
    <!-- 下拉弹层 — WinUI 3 Flyout 规格：8px 圆角 + elevation 阴影（阴影允许字面量） -->
    <Style Selector="ComboBox.FluentComboBox /template/ Border#PopupBorder">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BoxShadow" Value="0 8 16 0 #14000000" />
    </Style>

    <!-- ===== FluentListItem（WinUI 3 ListViewItem 风格） ===== -->
    <Style Selector="ListBoxItem.FluentListItem">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem.FluentListItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem.FluentListItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>
    <!-- WinUI 3 选中态：Accent 填充 + 反色文字 + SemiBold -->
    <Style Selector="ListBoxItem.FluentListItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBoxItem.FluentListItem:selected /template/ Border#PART_SelectedItemBorder">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBoxItem.FluentListItem:selected:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource FluentAccentPressedBrush}" />
    </Style>

    <!-- ===== FluentToolTip（WinUI 3 ToolTip 风格） ===== -->
    <Style Selector="ToolTip.FluentToolTip">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===== FluentContextMenu / FluentMenuItem（WinUI 3 MenuFlyout 风格） ===== -->
    <Style Selector="ContextMenu.FluentContextMenu">
        <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem.FluentMenuItem">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="MenuItem.FluentMenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
    </Style>
    <Style Selector="MenuItem.FluentMenuItem:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
    </Style>
    <Style Selector="MenuItem.FluentMenuItem:disabled">
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText2}" />
    </Style>

    <!-- ===== FluentTabView / FluentTabItem（WinUI 3 TabView 下划线风格） ===== -->
    <Style Selector="TabControl.FluentTabView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- 基础态保持 3px 底边（透明）避免选中时布局跳动；选中态点亮 accent 下划线 -->
    <Style Selector="TabItem.FluentTabItem">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="4,4,0,0" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText1}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.083" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.083" />
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="TabItem.FluentTabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
    </Style>
    <Style Selector="TabItem.FluentTabItem:selected">
        <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FluentColorText0}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</Styles>
