<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DevToys Windows 配色（提交 2dbbc8aa594978d11165a0e8112243c96a277dbc）：
         https://github.com/DevToys-app/DevToys/blob/2dbbc8aa594978d11165a0e8112243c96a277dbc/src/app/dev/DevToys.Blazor/Assets/sass/theme/windows/dark.scss
         上游透明原生窗口背景用不透明中性外壳表示；内容区为合成层。
         卡片悬停合成上游 GridView 6% 悬停滤镜；按下复用悬停（上游无 active 态）。 -->

    <!-- Primary / Accent (DevToys Windows #62CDFE) -->
    <SolidColorBrush x:Key="FluentColorPrimary" Color="#62CDFE" />
    <SolidColorBrush x:Key="FluentColorPrimaryPointerover" Color="#E662CDFE" />
    <SolidColorBrush x:Key="FluentColorPrimaryActive" Color="#CC62CDFE" />
    <SolidColorBrush x:Key="FluentColorPrimaryDisabled" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="FluentColorPrimaryLight" Color="#2662CDFE" />
    <SolidColorBrush x:Key="FluentColorPrimaryLightPointerover" Color="#3362CDFE" />
    <SolidColorBrush x:Key="FluentColorPrimaryLightActive" Color="#4062CDFE" />

    <!-- Secondary -->
    <SolidColorBrush x:Key="FluentColorSecondary" Color="#62CDFE" />
    <SolidColorBrush x:Key="FluentColorSecondaryPointerover" Color="#E662CDFE" />
    <SolidColorBrush x:Key="FluentColorSecondaryActive" Color="#CC62CDFE" />
    <SolidColorBrush x:Key="FluentColorSecondaryDisabled" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="FluentColorSecondaryLight" Color="#2662CDFE" />
    <SolidColorBrush x:Key="FluentColorSecondaryLightPointerover" Color="#3362CDFE" />
    <SolidColorBrush x:Key="FluentColorSecondaryLightActive" Color="#4062CDFE" />

    <!-- Tertiary (Fluent Subtle) -->
    <SolidColorBrush x:Key="FluentColorTertiary" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="FluentColorTertiaryPointerover" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FluentColorTertiaryActive" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="FluentColorTertiaryLight" Color="Transparent" />
    <SolidColorBrush x:Key="FluentColorTertiaryLightPointerover" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="FluentColorTertiaryLightActive" Color="#0BFFFFFF" />

    <!-- Information -->
    <SolidColorBrush x:Key="FluentColorInformation" Color="#62CDFE" />
    <SolidColorBrush x:Key="FluentColorInformationPointerover" Color="#E662CDFE" />
    <SolidColorBrush x:Key="FluentColorInformationActive" Color="#CC62CDFE" />
    <SolidColorBrush x:Key="FluentColorInformationDisabled" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="FluentColorInformationLight" Color="#2662CDFE" />
    <SolidColorBrush x:Key="FluentColorInformationLightPointerover" Color="#3362CDFE" />
    <SolidColorBrush x:Key="FluentColorInformationLightActive" Color="#4062CDFE" />

    <!-- Success (Fluent Success #6CCB5F) -->
    <SolidColorBrush x:Key="FluentColorSuccess" Color="#6CCB5F" />
    <SolidColorBrush x:Key="FluentColorSuccessPointerover" Color="#8FD984" />
    <SolidColorBrush x:Key="FluentColorSuccessActive" Color="#B2E5A9" />
    <SolidColorBrush x:Key="FluentColorSuccessDisabled" Opacity="0.35" Color="#6CCB5F" />
    <SolidColorBrush x:Key="FluentColorSuccessLight" Opacity="0.2" Color="#6CCB5F" />
    <SolidColorBrush x:Key="FluentColorSuccessLightPointerover" Opacity="0.3" Color="#6CCB5F" />
    <SolidColorBrush x:Key="FluentColorSuccessLightActive" Opacity="0.4" Color="#6CCB5F" />

    <!-- Warning (Fluent Caution #FCE100) -->
    <SolidColorBrush x:Key="FluentColorWarning" Color="#FCE100" />
    <SolidColorBrush x:Key="FluentColorWarningPointerover" Color="#FDE94A" />
    <SolidColorBrush x:Key="FluentColorWarningActive" Color="#FEF08A" />
    <SolidColorBrush x:Key="FluentColorWarningLight" Opacity="0.2" Color="#FCE100" />
    <SolidColorBrush x:Key="FluentColorWarningLightPointerover" Opacity="0.3" Color="#FCE100" />
    <SolidColorBrush x:Key="FluentColorWarningLightActive" Opacity="0.4" Color="#FCE100" />

    <!-- Danger (Fluent Critical #FF99A4) -->
    <SolidColorBrush x:Key="FluentColorDanger" Color="#FF99A4" />
    <SolidColorBrush x:Key="FluentColorDangerPointerover" Color="#FFBCBC" />
    <SolidColorBrush x:Key="FluentColorDangerActive" Color="#FFDEDE" />
    <SolidColorBrush x:Key="FluentColorDangerLight" Opacity="0.2" Color="#FF99A4" />
    <SolidColorBrush x:Key="FluentColorDangerLightPointerover" Opacity="0.3" Color="#FF99A4" />
    <SolidColorBrush x:Key="FluentColorDangerLightActive" Opacity="0.4" Color="#FF99A4" />

    <!-- Text and Icons (DevToys Windows 文本层级) -->
    <SolidColorBrush x:Key="FluentColorText0" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FluentColorText1" Color="#C4FFFFFF" />
    <SolidColorBrush x:Key="FluentColorText2" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="FluentColorText3" Color="#5CFFFFFF" />

    <!-- FluentTextPrimary/Secondary/TertiaryBrush 命名别名（兼容 F:\Code 项目引用） -->
    <StaticResource x:Key="FluentTextPrimaryBrush" ResourceKey="FluentColorText0" />
    <StaticResource x:Key="FluentTextSecondaryBrush" ResourceKey="FluentColorText1" />
    <StaticResource x:Key="FluentTextTertiaryBrush" ResourceKey="FluentColorText2" />

    <!-- Link -->
    <SolidColorBrush x:Key="FluentColorLink" Color="#9AECFE" />
    <SolidColorBrush x:Key="FluentColorLinkPointerover" Color="#9AECFE" />
    <SolidColorBrush x:Key="FluentColorLinkActive" Color="#9AECFE" />
    <SolidColorBrush x:Key="FluentColorLinkVisited" Color="#9AECFE" />

    <!-- Background (封装层 / 内容层) -->
    <SolidColorBrush x:Key="FluentColorBackground0" Color="#202020" />
    <SolidColorBrush x:Key="FluentColorBackground1" Color="#282828" />
    <SolidColorBrush x:Key="FluentColorBackground2" Color="#282828" />
    <SolidColorBrush x:Key="FluentColorBackground3" Color="#2C2C2C" />
    <SolidColorBrush x:Key="FluentColorBackground4" Color="#202020" />

    <!-- Fill (Fluent Subtle Fill) -->
    <SolidColorBrush x:Key="FluentColorFill0" Color="#19000000" />
    <SolidColorBrush x:Key="FluentColorFill1" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="FluentColorFill2" Color="#12FFFFFF" />

    <!-- Border (Fluent CardStroke / Divider) -->
    <SolidColorBrush x:Key="FluentColorBorder" Color="#1A000000" />
    <SolidColorBrush x:Key="FluentColorFocusBorder" Color="#62CDFE" />

    <!-- Disabled -->
    <SolidColorBrush x:Key="FluentColorDisabledText" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="FluentColorDisabledBorder" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="FluentColorDisabledBackground" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="FluentColorDisabledFill" Color="#0BFFFFFF" />

    <!-- Others -->
    <SolidColorBrush x:Key="FluentColorNavBackground" Color="#202020" />
    <SolidColorBrush x:Key="FluentColorOverlayBackground" Opacity="0.6" Color="#202020" />
    <SolidColorBrush x:Key="FluentColorHighlightBackground" Opacity="0.2" Color="#FCE100" />
    <SolidColorBrush x:Key="FluentColorHighlight" Color="#FFFFFF" />

    <!-- Shadow (DevToys 卡片无阴影) -->
    <BoxShadows x:Key="FluentColorShadow">0 0 0 0 Transparent</BoxShadows>
    <BoxShadows x:Key="FluentShadowSunken">0 0 0 0 #00000000</BoxShadows>
    <BoxShadows x:Key="FluentShadowSoft">0 1 3 0 #2E000000</BoxShadows>
    <BoxShadows x:Key="FluentShadowRaised">0 2 6 0 #3D000000, 0 6 12 0 #26000000</BoxShadows>
    <BoxShadows x:Key="FluentShadowElevated">inset 0 0 0 1 #1AFFFFFF, 0 4 14 #40000000</BoxShadows>

    <!-- Fluent Background Colors for direct use -->
    <Color x:Key="FluentAccentColor">#62CDFE</Color>
    <Color x:Key="FluentAccentPointeroverColor">#E662CDFE</Color>
    <Color x:Key="FluentAccentPressedColor">#CC62CDFE</Color>
    <SolidColorBrush x:Key="FluentAccentBrush" Color="#62CDFE" />
    <SolidColorBrush x:Key="FluentAccentPointeroverBrush" Color="#E662CDFE" />
    <SolidColorBrush x:Key="FluentAccentPressedBrush" Color="#CC62CDFE" />
    <SolidColorBrush x:Key="FluentAccentDisabledBrush" Opacity="0.35" Color="#62CDFE" />
    <SolidColorBrush x:Key="FluentAccentForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="FluentCardBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="FluentCardSecondaryBackgroundBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="FluentCardStrokeBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="FluentCardStrokePointeroverBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="FluentCardBackgroundPointeroverBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="FluentCardBackgroundPressedBrush" Color="#3F3F3F" />
    <!-- Layer background (nav pane + title bar, same layer for visual consistency) -->
    <SolidColorBrush x:Key="FluentSubtleBrush" Color="#202020" />
    <SolidColorBrush x:Key="FluentSubtleHoverBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="FluentSubtlePressedBrush" Color="#0BFFFFFF" />
    <!-- NavItem 选中态背景（DevToys 使用中性底色，命令条复用该 token） -->
    <SolidColorBrush x:Key="FluentNavItemSelectedBackgroundBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="FluentNavItemSelectedHoverBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="FluentNavItemSelectedPressedBrush" Color="#0BFFFFFF" />

    <!-- ===== shell / surface 语义 brush ===== -->
    <SolidColorBrush x:Key="FluentShellBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="FluentPageBackgroundBrush" Color="#282828" />
    <SolidColorBrush x:Key="FluentNavPaneBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="FluentTitleBarBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="FluentSearchBoxBackgroundBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="FluentDividerBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="FluentShellContentBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="FluentShellTitleBarBorderBrush" Color="#0FFFFFFF" />
    <BoxShadows x:Key="FluentPaneBoxShadow">0 0 0 0 Transparent</BoxShadows>
    <BoxShadows x:Key="FluentShellContentBoxShadow">0 0 0 0 Transparent</BoxShadows>
    <!-- WinUI 3 Mica 材质半透明 shell — 窗口 ActualTransparencyLevel==Mica 时由 MainWindow 运行时换入，
         透出系统桌面壁纸采样；不满足 Mica 时回退上方不透明 brush（Dark 模式需更高不透明度保证可读性） -->
    <SolidColorBrush x:Key="FluentShellMicaBrush" Color="#D9202020" />
    <BoxShadows x:Key="FluentCardBoxShadow">0 0 0 0 Transparent</BoxShadows>
    <BoxShadows x:Key="FluentCardPointeroverBoxShadow">0 0 0 0 Transparent</BoxShadows>

    <!-- ===== 主机表面：DevToys 首页 Hero 配色与主题文字；不复刻上游品牌图案 ===== -->
    <SolidColorBrush x:Key="FluentHeroBackgroundBrush" Color="#805B2A86" />
    <SolidColorBrush x:Key="FluentHeroDecorationBrush" Color="#1A9AECFE" />
    <SolidColorBrush x:Key="FluentHeroTextPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FluentHeroTextSecondaryBrush" Color="#C4FFFFFF" />
    <SolidColorBrush x:Key="FluentHeroTextTertiaryBrush" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="FluentIconSurfaceBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="FluentTextDisabledBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="FluentControlStrokeSecondaryBrush" Color="#8BFFFFFF" />

    <!-- ===== 布局尺寸 token ===== -->
    <x:Double x:Key="FluentPaneExpandedWidth">320</x:Double>
    <x:Double x:Key="FluentPaneCollapsedWidth">49</x:Double>
    <x:Double x:Key="FluentTitleBarHeight">48</x:Double>

    <!-- 浮层导航遮罩（40% 黑，参考 DevToys NavigationScrim） -->
    <SolidColorBrush x:Key="FluentNavigationScrimBrush" Color="#66000000" />

    <!-- ===== Avalonia-Fluent-UI semantic color tokens (WinUI 3 token mapping) ===== -->
    <!-- Text fill -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C4FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5CFFFFFF" />
    <!-- Text on accent (foreground on top of accent fills) -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Opacity="0.9" Color="#000000" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Opacity="0.6" Color="#000000" />
    <!-- Control fill (semi-transparent layering) -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
    <!-- Accent fill (button backgrounds) -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#62CDFE" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E662CDFE" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC62CDFE" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Opacity="0.35" Color="#62CDFE" />
    <!-- Subtle fill (hover/press backgrounds) -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="#08FFFFFF" />
    <!-- Strokes -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8BFFFFFF" />
    <!-- Smoke / overlay (modal dimming) -->
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000" />

    <!-- Control elevation border (gradient) — top darker, bottom lighter.
         GradientStop.Color requires a Color literal (cannot use brush resource). -->
    <LinearGradientBrush x:Key="ControlElevationBorderBrush" TransformOrigin="50%,50%" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.Transform>
            <ScaleTransform ScaleY="-1" />
        </LinearGradientBrush.Transform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.5" Color="#5CFFFFFF" />
            <GradientStop Offset="1.0" Color="#0FFFFFFF" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <!-- Sizing tokens -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ButtonPadding">16,8</Thickness>

</ResourceDictionary>
