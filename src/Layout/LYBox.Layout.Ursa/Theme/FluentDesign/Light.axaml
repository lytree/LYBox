<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DevToys Windows 配色（提交 2dbbc8aa594978d11165a0e8112243c96a277dbc）：
         https://github.com/DevToys-app/DevToys/blob/2dbbc8aa594978d11165a0e8112243c96a277dbc/src/app/dev/DevToys.Blazor/Assets/sass/theme/windows/light.scss
         上游透明原生窗口背景用不透明中性外壳表示；内容区为合成层。
         卡片悬停合成上游 GridView 6% 悬停滤镜；按下复用悬停（上游无 active 态）。 -->

    <!-- Primary / Accent (DevToys Windows #0067C0) -->
    <SolidColorBrush x:Key="FluentColorPrimary" Color="#0067C0" />
    <SolidColorBrush x:Key="FluentColorPrimaryPointerover" Color="#E60067C0" />
    <SolidColorBrush x:Key="FluentColorPrimaryActive" Color="#CC0067C0" />
    <SolidColorBrush x:Key="FluentColorPrimaryDisabled" Color="#9B9B9B" />
    <SolidColorBrush x:Key="FluentColorPrimaryLight" Color="#0F0067C0" />
    <SolidColorBrush x:Key="FluentColorPrimaryLightPointerover" Color="#1A0067C0" />
    <SolidColorBrush x:Key="FluentColorPrimaryLightActive" Color="#290067C0" />

    <!-- Secondary -->
    <SolidColorBrush x:Key="FluentColorSecondary" Color="#0067C0" />
    <SolidColorBrush x:Key="FluentColorSecondaryPointerover" Color="#E60067C0" />
    <SolidColorBrush x:Key="FluentColorSecondaryActive" Color="#CC0067C0" />
    <SolidColorBrush x:Key="FluentColorSecondaryDisabled" Color="#9B9B9B" />
    <SolidColorBrush x:Key="FluentColorSecondaryLight" Color="#0F0067C0" />
    <SolidColorBrush x:Key="FluentColorSecondaryLightPointerover" Color="#1A0067C0" />
    <SolidColorBrush x:Key="FluentColorSecondaryLightActive" Color="#290067C0" />

    <!-- Tertiary (Fluent Subtle) -->
    <SolidColorBrush x:Key="FluentColorTertiary" Color="#9E000000" />
    <SolidColorBrush x:Key="FluentColorTertiaryPointerover" Color="#E4000000" />
    <SolidColorBrush x:Key="FluentColorTertiaryActive" Color="#72000000" />
    <SolidColorBrush x:Key="FluentColorTertiaryLight" Color="Transparent" />
    <SolidColorBrush x:Key="FluentColorTertiaryLightPointerover" Color="#09000000" />
    <SolidColorBrush x:Key="FluentColorTertiaryLightActive" Color="#06000000" />

    <!-- Information -->
    <SolidColorBrush x:Key="FluentColorInformation" Color="#0067C0" />
    <SolidColorBrush x:Key="FluentColorInformationPointerover" Color="#E60067C0" />
    <SolidColorBrush x:Key="FluentColorInformationActive" Color="#CC0067C0" />
    <SolidColorBrush x:Key="FluentColorInformationDisabled" Color="#9B9B9B" />
    <SolidColorBrush x:Key="FluentColorInformationLight" Color="#0F0067C0" />
    <SolidColorBrush x:Key="FluentColorInformationLightPointerover" Color="#1A0067C0" />
    <SolidColorBrush x:Key="FluentColorInformationLightActive" Color="#290067C0" />

    <!-- Success (WinUI SystemFillColorSuccess #0F7B0F) -->
    <SolidColorBrush x:Key="FluentColorSuccess" Color="#0F7B0F" />
    <SolidColorBrush x:Key="FluentColorSuccessPointerover" Color="#0C6A0C" />
    <SolidColorBrush x:Key="FluentColorSuccessActive" Color="#095809" />
    <SolidColorBrush x:Key="FluentColorSuccessDisabled" Color="#A0A0A0" />
    <SolidColorBrush x:Key="FluentColorSuccessLight" Color="#DFF6DD" />
    <SolidColorBrush x:Key="FluentColorSuccessLightPointerover" Color="#B8EBB4" />
    <SolidColorBrush x:Key="FluentColorSuccessLightActive" Color="#92E08B" />

    <!-- Warning (WinUI SystemFillColorCaution #9D5D00) -->
    <SolidColorBrush x:Key="FluentColorWarning" Color="#9D5D00" />
    <SolidColorBrush x:Key="FluentColorWarningPointerover" Color="#A38200" />
    <SolidColorBrush x:Key="FluentColorWarningActive" Color="#856800" />
    <SolidColorBrush x:Key="FluentColorWarningLight" Color="#FFF4CE" />
    <SolidColorBrush x:Key="FluentColorWarningLightPointerover" Color="#FFE79C" />
    <SolidColorBrush x:Key="FluentColorWarningLightActive" Color="#FFDA6A" />

    <!-- Danger (Fluent Critical #C42B1C) -->
    <SolidColorBrush x:Key="FluentColorDanger" Color="#C42B1C" />
    <SolidColorBrush x:Key="FluentColorDangerPointerover" Color="#A4262A" />
    <SolidColorBrush x:Key="FluentColorDangerActive" Color="#8A1A1E" />
    <SolidColorBrush x:Key="FluentColorDangerLight" Color="#FDE7E9" />
    <SolidColorBrush x:Key="FluentColorDangerLightPointerover" Color="#F8C6CB" />
    <SolidColorBrush x:Key="FluentColorDangerLightActive" Color="#F1A2AA" />

    <!-- Text and Icons (DevToys Windows 文本层级) -->
    <SolidColorBrush x:Key="FluentColorText0" Color="#E4000000" />
    <SolidColorBrush x:Key="FluentColorText1" Color="#9E000000" />
    <SolidColorBrush x:Key="FluentColorText2" Color="#72000000" />
    <SolidColorBrush x:Key="FluentColorText3" Color="#5C000000" />

    <!-- FluentTextPrimary/Secondary/TertiaryBrush 命名别名（兼容 F:\Code 项目引用） -->
    <StaticResource x:Key="FluentTextPrimaryBrush" ResourceKey="FluentColorText0" />
    <StaticResource x:Key="FluentTextSecondaryBrush" ResourceKey="FluentColorText1" />
    <StaticResource x:Key="FluentTextTertiaryBrush" ResourceKey="FluentColorText2" />

    <!-- Link -->
    <SolidColorBrush x:Key="FluentColorLink" Color="#003E92" />
    <SolidColorBrush x:Key="FluentColorLinkPointerover" Color="#001A68" />
    <SolidColorBrush x:Key="FluentColorLinkActive" Color="#001A68" />
    <SolidColorBrush x:Key="FluentColorLinkVisited" Color="#003E92" />

    <!-- Background (封装层 / 内容层) -->
    <SolidColorBrush x:Key="FluentColorBackground0" Color="#F3F3F3" />
    <SolidColorBrush x:Key="FluentColorBackground1" Color="#F9F9F9" />
    <SolidColorBrush x:Key="FluentColorBackground2" Color="#F9F9F9" />
    <SolidColorBrush x:Key="FluentColorBackground3" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FluentColorBackground4" Color="#F3F3F3" />

    <!-- Fill (Fluent Subtle Fill) -->
    <SolidColorBrush x:Key="FluentColorFill0" Color="#06000000" />
    <SolidColorBrush x:Key="FluentColorFill1" Color="#0F000000" />
    <SolidColorBrush x:Key="FluentColorFill2" Color="#18000000" />

    <!-- Border (Fluent CardStroke / Divider) -->
    <SolidColorBrush x:Key="FluentColorBorder" Color="#0F000000" />
    <SolidColorBrush x:Key="FluentColorFocusBorder" Color="#0067C0" />

    <!-- Disabled -->
    <SolidColorBrush x:Key="FluentColorDisabledText" Color="#5C000000" />
    <SolidColorBrush x:Key="FluentColorDisabledBorder" Color="#0F000000" />
    <SolidColorBrush x:Key="FluentColorDisabledBackground" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="FluentColorDisabledFill" Color="#4DF9F9F9" />

    <!-- Others -->
    <SolidColorBrush x:Key="FluentColorNavBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="FluentColorOverlayBackground" Opacity="0.3" Color="#000000" />
    <SolidColorBrush x:Key="FluentColorHighlightBackground" Color="#FFF4CE" />
    <SolidColorBrush x:Key="FluentColorHighlight" Color="#1A1A1A" />

    <!-- Shadow (DevToys 卡片无阴影) -->
    <BoxShadows x:Key="FluentColorShadow">0 0 0 0 Transparent</BoxShadows>
    <BoxShadows x:Key="FluentShadowSunken">0 0 0 0 #00000000</BoxShadows>
    <BoxShadows x:Key="FluentShadowSoft">0 1 2 0 #12000000</BoxShadows>
    <BoxShadows x:Key="FluentShadowRaised">0 2 6 0 #1F000000, 0 8 16 0 #0A000000</BoxShadows>
    <BoxShadows x:Key="FluentShadowElevated">0 2 8 #14000000, 0 8 16 #0A000000</BoxShadows>

    <!-- Fluent Background Colors for direct use -->
    <Color x:Key="FluentAccentColor">#0067C0</Color>
    <Color x:Key="FluentAccentPointeroverColor">#E60067C0</Color>
    <Color x:Key="FluentAccentPressedColor">#CC0067C0</Color>
    <SolidColorBrush x:Key="FluentAccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="FluentAccentPointeroverBrush" Color="#E60067C0" />
    <SolidColorBrush x:Key="FluentAccentPressedBrush" Color="#CC0067C0" />
    <SolidColorBrush x:Key="FluentAccentDisabledBrush" Opacity="0.35" Color="#0067C0" />
    <SolidColorBrush x:Key="FluentAccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FluentCardBackgroundBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="FluentCardSecondaryBackgroundBrush" Color="#80F6F6F6" />
    <SolidColorBrush x:Key="FluentCardStrokeBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="FluentCardStrokePointeroverBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="FluentCardBackgroundPointeroverBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="FluentCardBackgroundPressedBrush" Color="#EEEEEE" />
    <!-- Layer background (nav pane + title bar, same layer for visual consistency) -->
    <SolidColorBrush x:Key="FluentSubtleBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="FluentSubtleHoverBrush" Color="#09000000" />
    <SolidColorBrush x:Key="FluentSubtlePressedBrush" Color="#06000000" />
    <!-- NavItem 选中态背景（DevToys 使用中性底色，命令条复用该 token） -->
    <SolidColorBrush x:Key="FluentNavItemSelectedBackgroundBrush" Color="#09000000" />
    <SolidColorBrush x:Key="FluentNavItemSelectedHoverBrush" Color="#09000000" />
    <SolidColorBrush x:Key="FluentNavItemSelectedPressedBrush" Color="#06000000" />

    <!-- ===== shell / surface 语义 brush ===== -->
    <SolidColorBrush x:Key="FluentShellBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="FluentPageBackgroundBrush" Color="#F9F9F9" />
    <SolidColorBrush x:Key="FluentNavPaneBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="FluentTitleBarBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="FluentSearchBoxBackgroundBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="FluentDividerBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="FluentShellContentBorderBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="FluentShellTitleBarBorderBrush" Color="#0F000000" />
    <BoxShadows x:Key="FluentPaneBoxShadow">0 0 0 0 Transparent</BoxShadows>
    <BoxShadows x:Key="FluentShellContentBoxShadow">0 0 0 0 Transparent</BoxShadows>
    <!-- WinUI 3 Mica 材质半透明 shell — 窗口 ActualTransparencyLevel==Mica 时由 MainWindow 运行时换入，
         透出系统桌面壁纸采样；不满足 Mica 时回退上方不透明 brush -->
    <SolidColorBrush x:Key="FluentShellMicaBrush" Color="#B3F3F3F3" />
    <BoxShadows x:Key="FluentCardBoxShadow">0 0 0 0 Transparent</BoxShadows>
    <BoxShadows x:Key="FluentCardPointeroverBoxShadow">0 0 0 0 Transparent</BoxShadows>

    <!-- ===== 主机表面：DevToys 首页 Hero 配色与主题文字；不复刻上游品牌图案 ===== -->
    <SolidColorBrush x:Key="FluentHeroBackgroundBrush" Color="#598300FF" />
    <SolidColorBrush x:Key="FluentHeroDecorationBrush" Color="#0F8300FF" />
    <SolidColorBrush x:Key="FluentHeroTextPrimaryBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="FluentHeroTextSecondaryBrush" Color="#9E000000" />
    <SolidColorBrush x:Key="FluentHeroTextTertiaryBrush" Color="#72000000" />
    <SolidColorBrush x:Key="FluentIconSurfaceBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="FluentTextDisabledBrush" Color="#5C000000" />
    <SolidColorBrush x:Key="FluentControlStrokeSecondaryBrush" Color="#72000000" />

    <!-- ===== 布局尺寸 token ===== -->
    <x:Double x:Key="FluentPaneExpandedWidth">320</x:Double>
    <x:Double x:Key="FluentPaneCollapsedWidth">49</x:Double>
    <x:Double x:Key="FluentTitleBarHeight">48</x:Double>

    <!-- 浮层导航遮罩（40% 黑，参考 DevToys NavigationScrim） -->
    <SolidColorBrush x:Key="FluentNavigationScrimBrush" Color="#66000000" />

    <!-- ===== Avalonia-Fluent-UI semantic color tokens (WinUI 3 token mapping) ===== -->
    <!-- Text fill -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#72000000" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5C000000" />
    <!-- Text on accent (foreground on top of accent fills) -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Opacity="0.9" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Opacity="0.6" Color="#FFFFFF" />
    <!-- Control fill (semi-transparent layering) -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#4DF9F9F9" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
    <!-- Accent fill (button backgrounds) -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60067C0" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0067C0" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Opacity="0.35" Color="#0067C0" />
    <!-- Subtle fill (hover/press backgrounds) -->
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#09000000" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#06000000" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Opacity="0.3" Color="#F9F9F9" />
    <!-- Strokes -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#72000000" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#72000000" />
    <!-- Smoke / overlay (modal dimming) -->
    <SolidColorBrush x:Key="SmokeFillColorDefaultBrush" Color="#4D000000" />

    <!-- Control elevation border (gradient) — top darker, bottom lighter.
         GradientStop.Color requires a Color literal (cannot use brush resource). -->
    <LinearGradientBrush x:Key="ControlElevationBorderBrush" TransformOrigin="50%,50%" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.Transform>
            <ScaleTransform ScaleY="-1" />
        </LinearGradientBrush.Transform>
        <LinearGradientBrush.GradientStops>
            <GradientStop Offset="0.5" Color="#5C000000" />
            <GradientStop Offset="1.0" Color="#0F000000" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <!-- Sizing tokens -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ButtonPadding">16,8</Thickness>

</ResourceDictionary>
