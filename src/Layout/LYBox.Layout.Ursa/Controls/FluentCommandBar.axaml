<UserControl
    x:Class="LYBox.Layout.Ursa.Controls.FluentCommandBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LYBox.Layout.Ursa.Controls"
    x:Name="Root"
    x:CompileBindings="True"
    x:DataType="controls:FluentCommandBar">

    <UserControl.Styles>
        <!-- 主命令按钮：透明底 + hover 微底色（WinUI CommandBar 常态） -->
        <Style Selector="Button.FluentCommandItem, ToggleButton.FluentCommandItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource FluentTextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.083" />
                        <BrushTransition Property="Foreground" Duration="0:0:0.083" />
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.FluentCommandItem:pointerover, ToggleButton.FluentCommandItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.FluentCommandItem:pressed, ToggleButton.FluentCommandItem:pressed">
            <Setter Property="Background" Value="{DynamicResource FluentSubtlePressedBrush}" />
        </Style>
        <!-- 切换按钮选中态：accent 底色 + accent 图标文字 -->
        <Style Selector="ToggleButton.FluentCommandItem:checked">
            <Setter Property="Background" Value="{DynamicResource FluentNavItemSelectedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FluentAccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.FluentCommandItem:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource FluentNavItemSelectedHoverBrush}" />
        </Style>

        <!-- 紧凑模式（LabelPosition=Collapsed）：仅图标 -->
        <Style Selector="Button.FluentCommandItem.compact, ToggleButton.FluentCommandItem.compact">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="36" />
        </Style>

        <!-- 溢出面板内：整行左对齐 -->
        <Style Selector="Button.FluentCommandItem.over, ToggleButton.FluentCommandItem.over">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.FluentCommandItem.over StackPanel, ToggleButton.FluentCommandItem.over StackPanel">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- 分隔线 -->
        <Style Selector="Border.FluentCommandSeparator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style Selector="Border.FluentCommandSeparatorOverflow">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!-- 溢出按钮 -->
        <Style Selector="Button.FluentCommandOverflow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.FluentCommandOverflow:pointerover">
            <Setter Property="Background" Value="{DynamicResource FluentSubtleHoverBrush}" />
        </Style>

        <!-- 溢出浮出面板 -->
        <Style Selector="Border.FluentCommandOverflowPanel">
            <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="BoxShadow" Value="0 8 24 0 #29000000" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto" MinHeight="40">
        <ScrollViewer
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel
                Name="PrimaryPanel"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center" />
        </ScrollViewer>

        <Button
            Name="OverflowButton"
            Grid.Column="1"
            Classes="FluentCommandOverflow"
            Margin="6,0,0,0"
            IsVisible="{Binding #Root.HasOverflow}"
            Click="OnMoreClick"
            ToolTip.Tip="{DynamicResource TOOLTIP_MORE}">
            <PathIcon Width="16" Height="16" Data="{DynamicResource FluentMoreHorizontal20Regular}" />
        </Button>

        <Popup
            Name="PART_OverflowPopup"
            Grid.Column="1"
            Placement="BottomEdgeAlignedRight"
            PlacementTarget="{Binding #OverflowButton}"
            IsLightDismissEnabled="True"
            IsOpen="{Binding #Root.IsOverflowOpen, Mode=TwoWay}"
            WindowManagerAddShadowHint="False">
            <Border Classes="FluentCommandOverflowPanel" Margin="0,4,0,0">
                <StackPanel Name="OverflowPanel" Spacing="1" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
