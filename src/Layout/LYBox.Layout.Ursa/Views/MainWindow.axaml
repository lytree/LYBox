<u:UrsaWindow
    x:Class="LYBox.Layout.Ursa.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:viewModels="using:LYBox.Layout.Ursa.ViewModels"
    xmlns:views="clr-namespace:LYBox.Layout.Ursa.Views"
    xmlns:iri="https://irihi.tech/shared"
    Title=""
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    ExtendClientAreaToDecorationsHint="True"
    x:DataType="viewModels:MainWindowViewModel"
    WindowStartupLocation="CenterScreen"
    MinWidth="640"
    MinHeight="480"
    Icon="/Assets/lybox.ico"
    IsFullScreenButtonVisible="{OnPlatform {x:False}, Linux={x:True}}"
    IsManagedResizerVisible="{OnPlatform {x:False}, Linux={x:True}}"
    TransparencyLevelHint="Mica"
    Background="Transparent"
    mc:Ignorable="d">
    <!-- 标题栏三段式布局（工具坞风格）：
           左：返回 + 应用图标 + 品牌名；右：主题切换。
           返回入口常显（参考 DevToys 的「← DevToys」），无历史时点击回到首页；
           折叠按钮在侧边栏顶部，标题栏中部留空作为窗口拖拽区域。
           Title 设为空字符串，避免 WindowDrawnDecorations 的左侧标题文本与品牌区重叠。 -->
    <u:UrsaWindow.LeftContent>
        <StackPanel
            Orientation="Horizontal"
            Spacing="6"
            Margin="8,0,0,0"
            VerticalAlignment="Center">
            <Button
                Classes="FluentRailButton"
                Command="{Binding MainViewViewModel.BackCommand}"
                ToolTip.Tip="{DynamicResource TOOLTIP_BACK}">
                <PathIcon
                    Width="16" Height="16"
                    Data="{DynamicResource FluentArrowLeft20Regular}"
                    Foreground="{DynamicResource FluentColorText1}" />
            </Button>
            <Image
                Width="16" Height="16"
                Source="/Assets/lybox-logo-256.png"
                VerticalAlignment="Center" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource FluentColorText1}"
                Text="{DynamicResource APP_TITLE}" />
        </StackPanel>
    </u:UrsaWindow.LeftContent>
    <u:UrsaWindow.RightContent>
        <StackPanel
            Orientation="Horizontal"
            Spacing="4"
            Margin="0,0,10,0"
            VerticalAlignment="Center">
            <u:ThemeToggleButton
                IsThreeState="True"
                Mode="Controller" />
        </StackPanel>
    </u:UrsaWindow.RightContent>
    <views:MainView DataContext="{Binding MainViewViewModel}" />
</u:UrsaWindow>