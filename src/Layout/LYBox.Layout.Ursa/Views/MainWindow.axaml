<u:UrsaWindow
    x:Class="LYBox.Layout.Ursa.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:viewModels="using:LYBox.Layout.Ursa.ViewModels"
    xmlns:views="clr-namespace:LYBox.Layout.Ursa.Views"
    xmlns:iri="https://irihi.tech/shared"
    Title=""
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    ExtendClientAreaToDecorationsHint="True"
    x:DataType="viewModels:MainWindowViewModel"
    WindowStartupLocation="CenterScreen"
    MinWidth="640"
    MinHeight="480"
    Icon="/Assets/lybox.ico"
    IsFullScreenButtonVisible="{OnPlatform {x:False}, Linux={x:True}}"
    IsManagedResizerVisible="{OnPlatform {x:False}, Linux={x:True}}"
    TransparencyLevelHint="Mica"
    Background="Transparent"
    mc:Ignorable="d">
    <!-- 标题栏三段式布局（Win11 Fluent 风格）：
           左：汉堡折叠按钮；中：搜索框；右：工具按钮（主题切换等）。
           Title 设为空字符串，避免 WindowDrawnDecorations 的左侧标题文本与搜索框重叠。 -->
    <u:UrsaWindow.LeftContent>
        <Button
            Classes="FluentHamburger"
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            Command="{Binding MainViewViewModel.ToggleCollapseCommand}"
            ToolTip.Tip="{DynamicResource TOOLTIP_TOGGLE_NAV}">
            <PathIcon
                Width="20" Height="20"
                Data="{DynamicResource FluentLineHorizontal320Regular}"
                Foreground="{DynamicResource FluentColorText1}" />
        </Button>
    </u:UrsaWindow.LeftContent>
    <u:UrsaWindow.TitleBarContent>
        <TextBox
            Name="SearchBox"
            Classes="FluentSearchBox"
            Width="360"
            MinWidth="240"
            MaxWidth="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PlaceholderText="{DynamicResource SEARCH_PLACEHOLDER}"
            Text="{Binding MainViewViewModel.SearchText, Mode=TwoWay}">
            <TextBox.InnerLeftContent>
                <Path Width="14" Height="14"
                    Data="{DynamicResource FluentSearch20Regular}"
                    Fill="{DynamicResource FluentColorText2}" />
            </TextBox.InnerLeftContent>
        </TextBox>
    </u:UrsaWindow.TitleBarContent>
    <u:UrsaWindow.RightContent>
        <StackPanel
            Orientation="Horizontal"
            Spacing="4"
            Margin="0,0,10,0"
            VerticalAlignment="Center">
            <u:ThemeToggleButton
                IsThreeState="True"
                Mode="Controller" />
        </StackPanel>
    </u:UrsaWindow.RightContent>
    <views:MainView DataContext="{Binding MainViewViewModel}" />
</u:UrsaWindow>