<UserControl
    x:Class="LYBox.Layout.Ursa.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:LYBox.Plugin.Shared.Converters"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iri="https://irihi.tech/shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plugin="using:LYBox.Plugin.Shared"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:viewmodels="using:LYBox.Plugin.Shared.ViewModels"
    xmlns:vm="using:LYBox.Layout.Ursa.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:MainViewViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainViewViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:IconNameToPathConverter x:Key="IconConverter" />
    </UserControl.Resources>
    <Panel>
        <Panel.Styles>
            <Style Selector="Grid.Blur">
                <Setter Property="Effect" Value="blur(10)" />
            </Style>
        </Panel.Styles>
        <!-- 工具坞布局：左侧通高侧边栏（折叠/返回 + 搜索 + 导航 + 底部入口），右侧内容区贴边铺满。
             顶部 Margin=48 让出 UrsaWindow TitleBar 高度，避免与标题栏重合。 -->
        <Grid Classes.Blur="{Binding $parent[u:UrsaWindow].(u:OverlayDialogHost.IsInModalStatus)}"
              Margin="0,48,0,0"
              Background="{DynamicResource FluentShellBackgroundBrush}"
              ColumnDefinitions="Auto,*">
            <!-- 预留列：为侧栏占位（展开 320 / 折叠 49 / 浮层与隐藏 0）。
                 浮层态时占位为 0，侧栏改为覆盖在内容之上 -->
            <Border Width="{Binding NavigationReservedWidth}" IsHitTestVisible="False" />
            <!-- 浮层遮罩：窄窗打开导航时覆盖内容区，点击关闭 -->
            <Button
                Grid.ColumnSpan="2"
                ZIndex="1"
                Classes="FluentNavigationScrim"
                Focusable="False"
                IsVisible="{Binding IsNavigationOverlay}"
                Command="{Binding CloseNavigationOverlayCommand}" />
            <!-- 侧栏：展开/折叠时占用左侧预留宽度，浮层时左对齐覆盖内容；
                 窄窗且未打开浮层时完全隐藏（Hidden），顶栏由 MainWindow 补汉堡按钮唤出 -->
            <Border
                Classes="FluentNavPane"
                Grid.ColumnSpan="2"
                ZIndex="2"
                HorizontalAlignment="Left"
                IsVisible="{Binding !IsSidebarHidden}">
                <!-- 侧边栏四行：导航开关 /（折叠态放大镜入口 或 展开态搜索框）/ 导航项 / 底部入口
                     行高刻意对齐：折叠态 36+14=50，展开态 32+18=50，切换时导航列表不跳动 -->
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- 顶部：导航开关（DevToys sidebar-header 的 36 高 stealth 按钮，40x36） -->
                    <Button
                        Grid.Row="0"
                        Classes="FluentRailButton"
                        Width="40" Height="36"
                        Margin="4,0,4,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ToggleCollapseCommand}"
                        ToolTip.Tip="{DynamicResource TOOLTIP_TOGGLE_NAV}">
                        <PathIcon
                            Width="16" Height="16"
                            Data="{DynamicResource FluentLineHorizontal320Regular}"
                            Foreground="{DynamicResource FluentColorText1}" />
                    </Button>
                    <!-- 搜索区：折叠态放大镜入口 / 展开态搜索框 + 搜索建议下拉。
                         折叠态与展开态行高对齐（36+10=46 / 28+18=46），切换时导航列表不跳动 -->
                    <Grid Grid.Row="1">
                    <!-- 折叠态：放大镜入口，点击展开侧边栏并聚焦搜索框（与 Ctrl+F 等价） -->
                    <Button
                        Name="SearchRailButton"
                        Classes="FluentRailButton"
                        Width="40" Height="36"
                        Margin="4,4,4,6"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsCollapsed}"
                        Click="OnSearchRailButtonClick"
                        ToolTip.Tip="{DynamicResource TOOLTIP_SEARCH}">
                        <PathIcon
                            Width="16" Height="16"
                            Data="{DynamicResource FluentSearch20Regular}"
                            Foreground="{DynamicResource FluentColorText1}" />
                    </Button>
                    <!-- 搜索框：位于侧边栏顶部（折叠态隐藏）。
                         右侧内嵌「清除 + 搜索」两个按钮：搜索按钮常驻（输入过程中也不消失），
                         清除按钮仅在有输入时出现，且两个按钮占位固定，避免输入时文本区宽度跳动。 -->
                    <TextBox
                        Name="SearchBox"
                        Classes="FluentSearchBox"
                        Margin="16,6,17,12"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="{DynamicResource SEARCH_PLACEHOLDER}"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        IsVisible="{Binding !IsCollapsed}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SubmitSearchCommand}" />
                            <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                        </TextBox.KeyBindings>
                        <TextBox.InnerRightContent>
                            <!-- Fluent2 的 TextBox 模板不给 InnerRightContent 预留右内边距，
                                 这里用正向外边距让按钮距输入框右缘约 4px，避免图标被边框裁切 -->
                            <Grid ColumnDefinitions="20,20" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Button
                                    Grid.Column="0"
                                    Classes="FluentSearchActionButton"
                                    Command="{Binding ClearSearchCommand}"
                                    Focusable="False"
                                    IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    ToolTip.Tip="{DynamicResource TOOLTIP_SEARCH_CLEAR}">
                                    <Path
                                        Width="9" Height="9"
                                        Data="{DynamicResource FluentDismiss20Regular}"
                                        Fill="{DynamicResource FluentColorText2}" />
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    Classes="FluentSearchActionButton"
                                    Command="{Binding SubmitSearchCommand}"
                                    Focusable="False"
                                    ToolTip.Tip="{DynamicResource TOOLTIP_SEARCH}">
                                    <Path
                                        Width="12" Height="12"
                                        Data="{DynamicResource FluentSearch20Regular}"
                                        Fill="{DynamicResource FluentColorText2}" />
                                </Button>
                            </Grid>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <!-- 搜索建议下拉（参考 DevToys AutoSuggestBox 的下拉结果）：
                         命中项点击直达对应页面，回车等同选中第一条建议 -->
                    <Popup
                        Name="SearchSuggestionPopup"
                        Placement="BottomEdgeAlignedLeft"
                        PlacementTarget="{Binding #SearchBox}"
                        IsOpen="{Binding IsSearchSuggestionOpen, Mode=TwoWay}"
                        IsLightDismissEnabled="True">
                        <Border
                            MinWidth="240"
                            MaxHeight="340"
                            Margin="0,4,0,0"
                            Padding="4"
                            Background="{DynamicResource FluentCardBackgroundBrush}"
                            BorderBrush="{DynamicResource FluentCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            BoxShadow="{DynamicResource FluentPaneBoxShadow}">
                            <StackPanel>
                                <!-- 无命中：保留下拉并提示，避免输入时下拉闪烁消失 -->
                                <TextBlock
                                    Margin="12,8"
                                    FontSize="13"
                                    Foreground="{DynamicResource FluentColorText2}"
                                    Text="{DynamicResource SEARCH_NO_RESULTS}"
                                    IsVisible="{Binding HasNoSuggestions}" />
                                <ScrollViewer
                                    MaxHeight="320"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredSuggestions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SearchSuggestion">
                                            <Button
                                                Classes="FluentSearchSuggestionItem"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding ActivateCommand}">
                                                <Grid ColumnDefinitions="Auto,*" Height="32">
                                                    <PathIcon
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="{Binding IconName, Converter={StaticResource IconConverter}}"
                                                        Foreground="{DynamicResource FluentColorText1}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Text="{Binding Name}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                    </Grid>
                    <!-- NavMenu 菜单列表（无 Header/Footer，纯菜单项） -->
                    <u:NavMenu
                        Name="NavMenu"
                        Grid.Row="2"
                        Background="Transparent"
                        IsHorizontalCollapsed="{Binding IsCollapsed}"
                        ItemsSource="{Binding Menus.MenuItems}"
                        SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                        ExpandWidth="{DynamicResource FluentPaneExpandedWidth}"
                        CollapseWidth="{DynamicResource FluentPaneCollapsedWidth}"
                        HeaderBinding="{Binding}"
                        IconBinding="{Binding MenuIconName}"
                        SubMenuBinding="{Binding Children}">
                        <!-- 导航项标题：状态徽章（New/Beta 等）来自插件清单，未声明时不占位 -->
                        <u:NavMenu.HeaderTemplate>
                            <DataTemplate x:DataType="viewmodels:MenuItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{Binding MenuHeader}" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="FluentStatusBadge"
                                        Content="{Binding Status}"
                                        IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </Grid>
                            </DataTemplate>
                        </u:NavMenu.HeaderTemplate>
                        <u:NavMenu.IconTemplate>
                            <DataTemplate x:DataType="x:String">
                                <PathIcon
                                    Width="16" Height="16"
                                    Data="{Binding Converter={StaticResource IconConverter}}"
                                    Foreground="{DynamicResource FluentTextPrimaryBrush}" />
                            </DataTemplate>
                        </u:NavMenu.IconTemplate>
                    </u:NavMenu>
                    <!-- 底部：分隔线 + 管理扩展 + 设置（行高与导航项一致：34 项高 + 5,3 外边距） -->
                    <StackPanel Grid.Row="3" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                        <Rectangle
                            Height="1"
                            Margin="5,4"
                            Fill="{DynamicResource FluentCardStrokeBrush}"
                            IsVisible="{Binding !IsCollapsed}" />
                        <Button
                            Classes="FluentNavFooterItem"
                            Classes.selected="{Binding IsPluginsSelected}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="{DynamicResource TOOLTIP_PLUGIN_MANAGEMENT}"
                            Command="{Binding ActivateCommand}"
                            CommandParameter="PluginManagement">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- 选中指示条（与导航项一致：3×16 圆角强调色） -->
                                <Border
                                    Grid.ColumnSpan="2"
                                    Width="3" Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource FluentAccentBrush}"
                                    CornerRadius="3"
                                    IsVisible="{Binding IsPluginsSelected}"
                                    IsHitTestVisible="False" />
                                <PathIcon
                                    Width="16" Height="16"
                                    Margin="12,8,16,8"
                                    Data="{DynamicResource FluentPuzzlePiece20Regular}"
                                    Foreground="{DynamicResource FluentTextPrimaryBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,8,8,8"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding PluginText}"
                                    IsVisible="{Binding !IsCollapsed}" />
                            </Grid>
                        </Button>
                        <Button
                            Classes="FluentNavFooterItem"
                            Classes.selected="{Binding IsSettingsSelected}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="{DynamicResource TOOLTIP_SETTINGS}"
                            Command="{Binding ActivateCommand}"
                            CommandParameter="Settings">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- 选中指示条（与导航项一致：3×16 圆角强调色） -->
                                <Border
                                    Grid.ColumnSpan="2"
                                    Width="3" Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource FluentAccentBrush}"
                                    CornerRadius="3"
                                    IsVisible="{Binding IsSettingsSelected}"
                                    IsHitTestVisible="False" />
                                <PathIcon
                                    Width="16" Height="16"
                                    Margin="12,8,16,8"
                                    Data="{DynamicResource FluentSettings20Regular}"
                                    Foreground="{DynamicResource FluentTextPrimaryBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,8,8,8"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding SettingText}"
                                    IsVisible="{Binding !IsCollapsed}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧内容区：贴边铺满（页面自行负责内边距），首页由 Hero 头图 + 工具卡片网格组成 -->
            <Border Grid.Column="1" Classes="FluentMainContentSurface">
                <Grid RowDefinitions="Auto,*">
                    <!-- 面包屑导航（参考 DevToys）：首页 › 分组 › 当前页，仅层级页显示 -->
                    <ScrollViewer
                        IsVisible="{Binding ShowBreadcrumbs}"
                        Margin="24,12,24,0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavigationBreadcrumb">
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                        <Button
                                            Classes="FluentBreadcrumbItem"
                                            Content="{Binding Title}"
                                            Command="{Binding ActivateCommand}"
                                            IsVisible="{Binding !IsCurrent}"
                                            MaxWidth="280"
                                            ToolTip.Tip="{Binding Title}" />
                                        <TextBlock
                                            Classes="FluentBreadcrumbCurrent"
                                            Text="{Binding Title}"
                                            IsVisible="{Binding IsCurrent}"
                                            MaxWidth="280"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Classes="FluentBreadcrumbSeparator"
                                            Text="›"
                                            IsVisible="{Binding !IsCurrent}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ContentControl
                        Grid.Row="1"
                        Content="{Binding Content}"
                        IsEnabled="{Binding !IsPageLoading}">
                        <ContentControl.ContentTemplate>
                            <plugin:ViewLocator />
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <!-- 页面加载失败提示：浮在内容区顶部，不阻断侧栏继续切换页面 -->
                    <Border
                        Grid.Row="1"
                        ZIndex="2"
                        Classes="FluentInfoBar FluentInfoBarSeverityError"
                        Margin="16"
                        Padding="16,12"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        IsVisible="{Binding HasPageLoadError}">
                        <TextBlock Classes="FluentInfoBarMessage" Text="{Binding PageLoadError}" TextWrapping="Wrap" />
                    </Border>
                    <!-- 页面切换加载覆盖层：内容创建期间替代空白，避免闪烁 -->
                    <Grid Grid.Row="1" ZIndex="1" IsVisible="{Binding IsPageLoading}">
                        <Border Background="{DynamicResource FluentPageBackgroundBrush}" Opacity="0.85" />
                        <Border
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="16,12"
                            Background="{DynamicResource FluentCardBackgroundBrush}"
                            BorderBrush="{DynamicResource FluentCardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <u:LoadingIcon
                                    Classes="Large"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource FluentAccentBrush}"
                                    IsLoading="{Binding IsPageLoading}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource FluentColorText2}"
                                    Text="{DynamicResource LOADING_PAGE}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Panel>
</UserControl>
