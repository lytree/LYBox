<UserControl
    x:Class="LYBox.Layout.Ursa.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="using:LYBox.Plugin.Shared.Converters"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iri="https://irihi.tech/shared"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plugin="using:LYBox.Plugin.Shared"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:viewmodels="using:LYBox.Plugin.Shared.ViewModels"
    xmlns:vm="using:LYBox.Layout.Ursa.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:MainViewViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainViewViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:IconNameToPathConverter x:Key="IconConverter" />
    </UserControl.Resources>
    <Panel>
        <Panel.Styles>
            <Style Selector="Grid.Blur">
                <Setter Property="Effect" Value="blur(10)" />
            </Style>
        </Panel.Styles>
        <!-- 工具坞布局：左侧通高侧边栏（折叠/返回 + 搜索 + 导航 + 底部入口），右侧内容区贴边铺满。
             顶部 Margin=48 让出 UrsaWindow TitleBar 高度，避免与标题栏重合。 -->
        <Grid Classes.Blur="{Binding $parent[u:UrsaWindow].(u:OverlayDialogHost.IsInModalStatus)}"
              Margin="0,48,0,0"
              Background="{DynamicResource FluentShellBackgroundBrush}"
              ColumnDefinitions="Auto,*">
            <Border Classes="FluentNavPane" Grid.Column="0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- 顶部：折叠按钮（有历史时左侧出现返回按钮） -->
                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="2"
                        Margin="10,4,10,4">
                        <Button
                            Classes="FluentRailButton"
                            Command="{Binding BackCommand}"
                            IsVisible="{Binding CanGoBack}"
                            ToolTip.Tip="{DynamicResource TOOLTIP_BACK}">
                            <PathIcon
                                Width="16" Height="16"
                                Data="{DynamicResource FluentArrowLeft20Regular}"
                                Foreground="{DynamicResource FluentColorText1}" />
                        </Button>
                        <Button
                            Classes="FluentRailButton"
                            Command="{Binding ToggleCollapseCommand}"
                            ToolTip.Tip="{DynamicResource TOOLTIP_TOGGLE_NAV}">
                            <PathIcon
                                Width="16" Height="16"
                                Data="{DynamicResource FluentLineHorizontal320Regular}"
                                Foreground="{DynamicResource FluentColorText1}" />
                        </Button>
                    </StackPanel>
                    <!-- 搜索框：位于侧边栏顶部（折叠态隐藏） -->
                    <TextBox
                        Grid.Row="1"
                        Name="SearchBox"
                        Classes="FluentSearchBox"
                        Margin="10,0,10,10"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="{DynamicResource SEARCH_PLACEHOLDER}"
                        Text="{Binding SearchText, Mode=TwoWay}"
                        IsVisible="{Binding !IsCollapsed}">
                        <TextBox.InnerLeftContent>
                            <Path
                                Width="14" Height="14"
                                Margin="0,0,6,0"
                                Data="{DynamicResource FluentSearch20Regular}"
                                Fill="{DynamicResource FluentColorText2}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <!-- NavMenu 菜单列表（无 Header/Footer，纯菜单项） -->
                    <u:NavMenu
                        Name="NavMenu"
                        Grid.Row="2"
                        Background="Transparent"
                        IsHorizontalCollapsed="{Binding IsCollapsed}"
                        ItemsSource="{Binding Menus.MenuItems}"
                        SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                        ExpandWidth="{DynamicResource FluentPaneExpandedWidth}"
                        CollapseWidth="{DynamicResource FluentPaneCollapsedWidth}"
                        HeaderBinding="{Binding MenuHeader}"
                        IconBinding="{Binding MenuIconName}"
                        SubMenuBinding="{Binding Children}">
                        <u:NavMenu.IconTemplate>
                            <DataTemplate x:DataType="x:String">
                                <u:TwoTonePathIcon
                                    Width="20" Height="20"
                                    Data="{Binding Converter={StaticResource IconConverter}}"
                                    Foreground="{DynamicResource FluentTextSecondaryBrush}"
                                    StrokeBrush="{DynamicResource FluentTextSecondaryBrush}"
                                    ActiveForeground="{DynamicResource FluentAccentBrush}"
                                    ActiveStrokeBrush="{DynamicResource FluentAccentBrush}"
                                    IsActive="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=u:NavMenuItem}, Path=IsHighlighted, Mode=TwoWay}" />
                            </DataTemplate>
                        </u:NavMenu.IconTemplate>
                    </u:NavMenu>
                    <!-- 底部：管理扩展 + 设置 -->
                    <StackPanel Grid.Row="3" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                        <Border Classes="FluentDivider" Margin="10,0,10,6" />
                        <Button
                            Classes="FluentNavFooterItem"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            CornerRadius="4"
                            ToolTip.Tip="{DynamicResource TOOLTIP_PLUGIN_MANAGEMENT}"
                            Command="{Binding ActivateCommand}"
                            CommandParameter="PluginManagement">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon
                                    Width="20" Height="20"
                                    Margin="14,8,8,8"
                                    Data="{DynamicResource FluentPuzzlePiece20Regular}"
                                    Foreground="{DynamicResource FluentTextSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,8,8,8"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding PluginText}"
                                    IsVisible="{Binding !IsCollapsed}" />
                            </Grid>
                        </Button>
                        <Button
                            Classes="FluentNavFooterItem"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            CornerRadius="4"
                            ToolTip.Tip="{DynamicResource TOOLTIP_SETTINGS}"
                            Command="{Binding ActivateCommand}"
                            CommandParameter="Settings">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon
                                    Width="20" Height="20"
                                    Margin="14,8,8,8"
                                    Data="{DynamicResource FluentSettings20Regular}"
                                    Foreground="{DynamicResource FluentTextSecondaryBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,8,8,8"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{Binding SettingText}"
                                    IsVisible="{Binding !IsCollapsed}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧内容区：贴边铺满（页面自行负责内边距），首页由 Hero 头图 + 工具卡片网格组成 -->
            <Border Grid.Column="1" Classes="FluentMainContentSurface">
                <ContentControl Content="{Binding Content}">
                    <ContentControl.ContentTemplate>
                        <plugin:ViewLocator />
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Grid>
    </Panel>
</UserControl>
