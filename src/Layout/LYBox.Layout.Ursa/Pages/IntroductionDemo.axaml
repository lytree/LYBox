<UserControl
    x:Class="LYBox.Layout.Ursa.Pages.IntroductionDemo"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LYBox.Plugin.Shared.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:LYBox.Layout.Core.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:IntroductionDemoViewModel"
    d:DesignHeight="800"
    d:DesignWidth="1600"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:IntroductionDemoViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <converters:IconNameToPathConverter x:Key="IconConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="u|Badge.ToolStatus">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BadgeFontSize" Value="11" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
        <!-- Ursa Badge 的胶囊内边距写在模板 Border 上，需按状态标签的紧凑尺寸覆写 -->
        <Style Selector="u|Badge.ToolStatus /template/ Border#PART_BadgeContainer">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="16" />
        </Style>
    </UserControl.Styles>

    <!-- 首页布局：顶部通栏 Hero（欢迎语 + 版本号），下方自适应列宽的工具卡片网格 -->
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="FluentHeroBanner">
            <Grid>
                <!-- 装饰圆环：DevToys Hero 背景右上大圆环 + 右下实心圆，不参与命中测试 -->
                <Canvas IsHitTestVisible="False">
                    <Ellipse
                        Width="260" Height="260"
                        Canvas.Right="-52" Canvas.Top="-84"
                        Stroke="{DynamicResource FluentHeroDecorationBrush}"
                        StrokeThickness="28" />
                    <Ellipse
                        Width="112" Height="112"
                        Canvas.Right="148" Canvas.Top="124"
                        Fill="{DynamicResource FluentHeroDecorationBrush}" />
                </Canvas>
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <TextBlock Classes="FluentHeroTitle" Text="{Binding WelcomeTitle}" />
                    <TextBlock Classes="FluentHeroVersion" Text="{Binding VersionText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Panel Grid.Row="1">
            <!-- 空状态提示：未安装任何工具 -->
            <TextBlock
                IsVisible="{Binding HasNoTools}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,48"
                FontSize="16"
                Foreground="{DynamicResource FluentColorText2}"
                Text="{DynamicResource HOME_NO_TOOLS}"
                ZIndex="1" />
            <!-- 空状态提示：搜索无结果 -->
            <TextBlock
                IsVisible="{Binding HasNoResults}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,48"
                FontSize="16"
                Foreground="{DynamicResource FluentColorText2}"
                Text="{DynamicResource SEARCH_NO_RESULTS}"
                ZIndex="1" />
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <!-- 自适应列宽网格：列数按可用宽度与 330px 最小列宽推算（DevToys GridView ItemMinWidth=330）。
                     卡片自身带 16px 右下外边距作为间距，
                     外层右侧只留 8px，与左侧 24px 内边距合成 24px 视觉边距 -->
                <ItemsControl
                    Name="ToolGrid"
                    ItemsSource="{Binding FilteredItems}"
                    Margin="24,20,8,8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    SizeChanged="OnToolGridSizeChanged">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid
                                x:DataType="vm:IntroductionDemoViewModel"
                                Columns="{Binding GridColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolItem">
                            <Button
                                Classes="FluentToolCard"
                                Margin="0,0,16,16"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{Binding Key}"
                                ToolTip.Tip="{Binding Description}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- 左侧图标方块 -->
                                    <Border Grid.Column="0" Classes="FluentToolIconTile">
                                        <PathIcon
                                            Width="42" Height="42"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{Binding IconName, Converter={StaticResource IconConverter}}"
                                            Foreground="{DynamicResource FluentTextPrimaryBrush}" />
                                    </Border>
                                    <!-- 中部：名称 + 描述 -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="16,0,8,0"
                                        Spacing="9"
                                        VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="FluentToolCardTitle" Text="{Binding Name}" />
                                            <u:Badge
                                                Classes="ToolStatus Light Primary"
                                                Header="{Binding Status}"
                                                IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        </StackPanel>
                                        <TextBlock
                                            Classes="FluentToolCardDescription"
                                            Text="{Binding Description}"
                                            IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>
                                    <!-- 右上角「打开」指示（点击卡片即打开该工具） -->
                                    <PathIcon
                                        Grid.Column="2"
                                        Width="12" Height="12"
                                        Margin="0,3,0,0"
                                        VerticalAlignment="Top"
                                        Data="{DynamicResource FluentChevronRight16Regular}"
                                        Foreground="{DynamicResource FluentTextSecondaryBrush}"
                                        ToolTip.Tip="{DynamicResource HOME_OPEN_TOOL}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
