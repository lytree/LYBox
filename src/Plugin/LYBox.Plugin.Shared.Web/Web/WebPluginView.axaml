<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:web="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
             x:Class="LYBox.Plugin.Shared.Web.WebPluginView">
    <Border BorderBrush="{DynamicResource FluentCardStrokeBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
            <!-- 开发模式工具栏：调试 Web 插件页面时显示，用于导航与状态观察 -->
            <Border
                Name="PART_DevToolbar"
                Grid.Row="0"
                Padding="6,4"
                Background="{DynamicResource FluentSubtleBrush}"
                BorderBrush="{DynamicResource FluentCardStrokeBrush}"
                BorderThickness="0,0,0,1"
                IsVisible="False">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                    <Button
                        Name="PART_BackButton"
                        Grid.Column="0"
                        MinWidth="32"
                        Padding="7,3"
                        Click="OnDevBackClick"
                        Content="←"
                        ToolTip.Tip="Back" />
                    <Button
                        Name="PART_ForwardButton"
                        Grid.Column="1"
                        MinWidth="32"
                        Margin="4,0,0,0"
                        Padding="7,3"
                        Click="OnDevForwardClick"
                        Content="→"
                        ToolTip.Tip="Forward" />
                    <Button
                        Name="PART_RefreshButton"
                        Grid.Column="2"
                        MinWidth="32"
                        Margin="4,0,0,0"
                        Padding="7,3"
                        Click="OnDevRefreshClick"
                        Content="↻"
                        ToolTip.Tip="Refresh" />
                    <!-- 调试面板按钮：仅 Debug 构建（面板端点 #if DEBUG 裁剪），系统浏览器打开 /__lybox/debug -->
                    <Button
                        Name="PART_DebugPanelButton"
                        Grid.Column="3"
                        Margin="4,0,0,0"
                        Padding="7,3"
                        Click="OnDevDebugPanelClick"
                        Content="Debug"
                        IsVisible="False"
                        ToolTip.Tip="Open Debug Panel in browser" />
                    <Border Grid.Column="4" Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource FluentBackgroundBrush}">
                        <TextBlock Name="PART_ModeText" VerticalAlignment="Center" Classes="WinUICaption" />
                    </Border>
                    <TextBlock Grid.Column="5" Margin="8,0,4,0" VerticalAlignment="Center" Text="Route" Classes="WinUICaption" />
                    <TextBlock
                        Name="PART_RouteText"
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Classes="WinUICaption" />
                    <TextBlock
                        Name="PART_StatusText"
                        Grid.Column="7"
                        Margin="12,0,2,0"
                        VerticalAlignment="Center"
                        Classes="WinUICaption" />
                </Grid>
            </Border>
            <web:NativeWebView x:Name="PART_WebView" Grid.Row="1" />
            <!-- 懒加载占位：插件未主动注册 Web 服务时显示，不渲染 WebView -->
            <Border x:Name="PART_Placeholder" Grid.Row="1" IsVisible="False"
                    Background="{DynamicResource FluentBackgroundBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
                    <TextBlock Text="Web 服务未启用" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="PART_PlaceholderMessage" Text="" Opacity="0.7"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
