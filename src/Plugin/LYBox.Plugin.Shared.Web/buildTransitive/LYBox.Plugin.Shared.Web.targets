<Project>
  <Target Name="IncludeWebPluginAssets"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(IsPluginProject)' == 'true' And '$(PluginKind)' == 'Web' And Exists('$(PluginWwwroot)')">
    <ItemGroup>
      <_WebPluginAsset Include="$(MSBuildProjectDirectory)/$(PluginWwwroot)/**/*" />
      <Content Include="@(_WebPluginAsset)">
        <Link>$(PluginWwwroot)/%(_WebPluginAsset.RecursiveDir)%(_WebPluginAsset.Filename)%(_WebPluginAsset.Extension)</Link>
        <TargetPath>$(PluginWwwroot)/%(_WebPluginAsset.RecursiveDir)%(_WebPluginAsset.Filename)%(_WebPluginAsset.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <!--
    S3：Web 插件专属的共享程序集剔除已收敛到核心包的单源派生逻辑。
    本包 .props 通过 AdditionalSharedAssemblyPatterns 追加的 ASP.NET Core 条目，
    会与核心 _SharedAssembliesPatterns 一起由 LYBox.Plugin.Shared.targets 的
    ExcludeSharedAssembliesFromCopyLocal / CleanPublishedPluginOutput 统一剔除，
    并写入 shared-assemblies.txt —— 此处不再维护第二份硬编码清单。
  -->
</Project>