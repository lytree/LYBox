<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<IsPluginSdkProject>true</IsPluginSdkProject>
		<PackageId>LYBox.Plugin.Shared.Web</PackageId>
		<!-- SDK 与宿主共用 HostVersion：PluginSdkVersion 在根 Directory.Build.props 中已是 HostVersion 的别名 -->
		<Version>$(HostVersion)</Version>
		<Description>Web SDK for LYBox Avalonia Web plugins: WebView control, embedded Kestrel static host, WebView IPC (RPC/SSE/Channel), and browser-side JS + theme CSS assets.</Description>
		<Authors>LYBoxPlugin</Authors>
		<PackageTags>avalonia;plugin;web;webview;ipc;sse;javascript;css</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/example/AvaloniaTemplate</PackageProjectUrl>
		<RepositoryUrl>https://github.com/example/AvaloniaTemplate</RepositoryUrl>
	</PropertyGroup>

	<!--
		S3 依赖拆分：Web 包只被 Web 插件引用，非 Web 插件不背负 ASP.NET Core 与 WebView。
		  - ProjectReference 核心包：打包时自动转为 LYBox.Plugin.Shared 包依赖（同版本）。
		  - FrameworkReference ASP.NET Core：Kestrel + 静态文件 + SSE 端点所需（仅 Web 包）。
		  - Avalonia.Controls.WebView：官方 WebView 控件，承载前端页面。
	-->
	<ItemGroup>
		<ProjectReference Include="../LYBox.Plugin.Shared/LYBox.Plugin.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Avalonia.Controls.WebView" Version="$(AvaloniaControlsWebView)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="buildTransitive\LYBox.Plugin.Shared.Web.props" Pack="true" PackagePath="buildTransitive\net10.0\LYBox.Plugin.Shared.Web.props" />
		<None Include="buildTransitive\LYBox.Plugin.Shared.Web.targets" Pack="true" PackagePath="buildTransitive\net10.0\LYBox.Plugin.Shared.Web.targets" />
	</ItemGroup>

	<!--
		WebView IPC 引导脚本：作为嵌入资源打包，由 WebViewIpcHost.LoadBootstrap() 运行时读取
		并经 IRpcTransport.ExecuteScriptAsync 注入页面。
	-->
	<ItemGroup>
		<EmbeddedResource Include="Rpc\Assets\ipc.js" />
		<!-- S4 浏览器端 SDK 资源：供直接 <script type="module"> 引用，由 WebHostService 暴露在 /sdk/ 下 -->
		<EmbeddedResource Include="Assets\lybox-plugin-sdk.js" LogicalName="LYBox.Plugin.Shared.Web.Assets.lybox-plugin-sdk.js" />
		<!--
			TS 类型声明：与 .js 一一对应，由 WebHostService 在 /sdk/lybox-plugin-sdk.d.ts 暴露。
			前端 import 'lybox' 时拿到的类型提示来自本资源（Vite dev 经同源代理转发；WebView 生产直连宿主）。
		-->
		<EmbeddedResource Include="Assets\lybox-plugin-sdk.d.ts" LogicalName="LYBox.Plugin.Shared.Web.Assets.lybox-plugin-sdk.d.ts" />
		<EmbeddedResource Include="Assets\lybox-plugin-theme.css" LogicalName="LYBox.Plugin.Shared.Web.Assets.lybox-plugin-theme.css" />
	</ItemGroup>

	<!--
		WebHostService.MapPluginRoot 为 internal（S2 BC-3），经 InternalsVisibleTo
		授权宿主（LYBox.Layout.Core）与测试项目调用。
	-->
	<ItemGroup>
		<InternalsVisibleTo Include="LYBox.Tests" />
		<InternalsVisibleTo Include="LYBox.Layout.Core" />
	</ItemGroup>

</Project>