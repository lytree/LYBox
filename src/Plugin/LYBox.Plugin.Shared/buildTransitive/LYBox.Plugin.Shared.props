<Project>
  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LYBoxPluginSharedExclusionsEnabled Condition="'$(LYBoxPluginSharedExclusionsEnabled)' == ''">true</LYBoxPluginSharedExclusionsEnabled>
    <GeneratePluginManifest Condition="'$(GeneratePluginManifest)' == ''">true</GeneratePluginManifest>
    <!--
      Web 插件声明（S1）：以 csproj 为单一事实来源，构建期写入 plugin.json 清单（kind/web），
      运行期由宿主据此注册。默认值使非 Web 插件无需声明即可获得 Avalonia 分类（向后兼容）。
    -->
    <PluginKind Condition="'$(PluginKind)' == ''">Avalonia</PluginKind>
    <PluginWwwroot Condition="'$(PluginWwwroot)' == ''">wwwroot</PluginWwwroot>
    <PluginEntryPage Condition="'$(PluginEntryPage)' == ''">index.html</PluginEntryPage>
  </PropertyGroup>

  <!--
    Must-share assemblies: these are forwarded to the host's default AssemblyLoadContext
    at runtime because their types appear in LYBox.Plugin.Shared's public API or base classes.
    Everything NOT listed here is plugin-local (each plugin loads its own copy).

    Principle: an assembly must be shared if and only if:
      - It is part of the .NET runtime/BCL, OR
      - It is part of the Avalonia UI framework (host renders plugin views), OR
      - It defines types used in LYBox.Plugin.Shared's public API (e.g. IPlugin, ViewModelBase), OR
      - It is a transitive dependency required by the above.

    The _SharedAssembliesPatterns property below is the single source of truth for
    shared-assemblies.txt (consumed at runtime by PluginLoadContext). Each line is either
    an exact assembly name or a prefix pattern ending with '*'.

    NOTE: We use a property (not ItemGroup Include) because MSBuild treats Include="Foo.*"
    as a glob pattern and expands it to matching filenames in the project directory.
    A property preserves the literal "*" character.
  -->
  <!--
    Expose plugin metadata MSBuild properties to the Roslyn source generator
    (LYBox.Plugin.Generators.MetadataGenerator) via build_property.* global options.
    This makes the csproj the single source of truth for IPluginMetadata, so the
    generator emits Name/Version/Author/Description/PluginId/MinPluginSdkVersion
    instead of them being hand-written twice in the plugin entry class (O-1/O-8).
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="PluginId" />
    <CompilerVisibleProperty Include="PluginName" />
    <CompilerVisibleProperty Include="PluginAuthor" />
    <CompilerVisibleProperty Include="PluginDescription" />
    <CompilerVisibleProperty Include="PluginVersion" />
    <CompilerVisibleProperty Include="MinPluginSdkVersion" />
    <CompilerVisibleProperty Include="PluginKind" />
    <CompilerVisibleProperty Include="PluginWwwroot" />
    <CompilerVisibleProperty Include="PluginEntryPage" />
  </ItemGroup>

  <PropertyGroup Condition="'$(LYBoxPluginSharedExclusionsEnabled)' == 'true'">
    <_SharedAssembliesPatterns>$(_SharedAssembliesPatterns)System.*
System.Private.Uri
System.Reactive
Microsoft.Bcl.AsyncInterfaces
Avalonia
Avalonia.*
SkiaSharp
SkiaSharp.*
HarfBuzzSharp
HarfBuzzSharp.*

LYBox.Plugin.Shared
LYBox.Plugin.Shared.UI
CommunityToolkit.*
Microsoft.Extensions.DependencyInjection
Microsoft.Extensions.DependencyInjection.Abstractions
Microsoft.Extensions.Options
Microsoft.Extensions.Primitives
Microsoft.Extensions.Logging.Abstractions
Irihi.*
Ursa
Semi.Avalonia
Microsoft.EntityFrameworkCore
Microsoft.EntityFrameworkCore.*
ProDataGrid
System.Net.Http
System.Security.Cryptography.*
</_SharedAssembliesPatterns>
  </PropertyGroup>
</Project>
