<Project>
  <!--
    Single-source shared-assembly filtering.

    LYBox.Plugin.Shared.props defines _SharedAssembliesPatterns (the runtime contract, written
    to shared-assemblies.txt and consumed by PluginLoadContext at runtime). Other packages may
    extend the list via AdditionalSharedAssemblyPatterns (e.g. LYBox.Plugin.Shared.Web appends
    ASP.NET Core entries).

    All build-time stripping (copy-local and publish cleanup) below is DERIVED from those two
    properties, so build-time exclusions and runtime forwarding can never drift apart.

    Pattern syntax: an exact assembly name, or a prefix pattern ending with '*'.

    NOTE: the classification is done by the ParseSharedAssemblyPatterns inline task instead of
    ItemGroup transforms, because property-function results escape ';' as %3B (breaking
    Include-based splitting) and '*' in Include specs is treated as a filename glob. The task
    receives the raw multiline string and does the splitting/regex-escaping deterministically.
  -->

  <UsingTask TaskName="ParseSharedAssemblyPatterns" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Patterns ParameterType="System.String" Required="true" />
      <PrefixRegexBody ParameterType="System.String" Output="true" />
      <ExactRegexBody ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var prefixes = new List<string>();
        var exacts = new List<string>();
        foreach (var entry in Patterns.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var pattern = entry.Trim();
            if (pattern.Length == 0) continue;
            // Regex.Escape handles '.' and '*'; a prefix pattern drops its trailing "\*"
            // so it stays an unanchored match, exact names are anchored by the caller ("^(...)$").
            var escaped = Regex.Escape(pattern);
            if (pattern.EndsWith("*", StringComparison.Ordinal))
            {
                var body = escaped.Substring(0, escaped.Length - 2);
                if (body.Length > 0) prefixes.Add(body);
            }
            else
            {
                exacts.Add(escaped);
            }
        }
        PrefixRegexBody = string.Join("|", prefixes);
        ExactRegexBody = string.Join("|", exacts);
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Derive matching regexes from $(_SharedAssembliesPatterns)$(AdditionalSharedAssemblyPatterns).
    Runs once per project; the targets below depend on it. When the pattern list is empty
    (exclusions disabled) the regexes degrade to ^$ which never matches an assembly name.
  -->
  <Target Name="_ComputeSharedAssemblyFilters">
    <PropertyGroup>
      <_SharedPatternsRaw>$(_SharedAssembliesPatterns)$(AdditionalSharedAssemblyPatterns)</_SharedPatternsRaw>
      <_SharedPrefixRegex>^$</_SharedPrefixRegex>
      <_SharedExactRegex>^$</_SharedExactRegex>
    </PropertyGroup>
    <ParseSharedAssemblyPatterns Condition="'$(_SharedPatternsRaw.Trim())' != ''" Patterns="$(_SharedPatternsRaw)">
      <Output TaskParameter="PrefixRegexBody" PropertyName="_SharedPrefixBody" />
      <Output TaskParameter="ExactRegexBody" PropertyName="_SharedExactBody" />
    </ParseSharedAssemblyPatterns>
    <PropertyGroup>
      <_SharedPrefixRegex Condition="'$(_SharedPrefixBody)' != ''">^($(_SharedPrefixBody))</_SharedPrefixRegex>
      <_SharedExactRegex Condition="'$(_SharedExactBody)' != ''">^($(_SharedExactBody))$</_SharedExactRegex>
    </PropertyGroup>
  </Target>

  <!--
    Filter ReferenceCopyLocalPaths: only must-share assemblies (contract/framework) are stripped
    from plugin output. Everything else stays plugin-local. The plugin's own assembly is never
    removed, regardless of its name.
  -->
  <Target Name="ExcludeSharedAssembliesFromCopyLocal"
          AfterTargets="ResolveAssemblyReferences"
          DependsOnTargets="_ComputeSharedAssemblyFilters"
          Condition="'$(LYBoxPluginSharedExclusionsEnabled)' == 'true'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
          Condition="'%(Filename)' != '$(AssemblyName)'
                     And $([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_SharedPrefixRegex)'))" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
          Condition="'%(Filename)' != '$(AssemblyName)'
                     And $([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_SharedExactRegex)'))" />
    </ItemGroup>
  </Target>

  <!--
    Clean must-share assemblies from the published plugin output directory (same set as
    copy-local, plus process-wide native libraries that the host already ships).
  -->
  <Target Name="CleanPublishedPluginOutput"
          AfterTargets="Publish"
          DependsOnTargets="_ComputeSharedAssemblyFilters"
          Condition="'$(IsPluginProject)' == 'true' And '$(LYBoxPluginSharedExclusionsEnabled)' == 'true'">
    <ItemGroup>
      <_PublishedFiles Include="$(PublishDir)**\*.dll" />
      <_PublishedFiles Include="$(PublishDir)**\*.pdb" />
      <_PublishedFiles Include="$(PublishDir)**\*.xml" />
      <_PublishedNativeFiles Include="$(PublishDir)runtimes\**\*.*" />
    </ItemGroup>
    <ItemGroup>
      <_ExcludedPublished Include="@(_PublishedFiles)"
          Condition="'%(Filename)' != '$(AssemblyName)'
                     And $([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_SharedPrefixRegex)'))" />
      <_ExcludedPublished Include="@(_PublishedFiles)"
          Condition="'%(Filename)' != '$(AssemblyName)'
                     And $([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_SharedExactRegex)'))" />

      <!-- Native libraries shared process-wide (host provides them; not part of the managed
           pattern list, hence still enumerated here). -->
      <_ExcludedNativePublished Include="@(_PublishedNativeFiles)" Condition="'%(Filename)' == 'e_sqlite3'" />
      <_ExcludedNativePublished Include="@(_PublishedNativeFiles)" Condition="'%(Filename)' == 'libe_sqlite3'" />
      <_ExcludedNativePublished Include="@(_PublishedNativeFiles)" Condition="'%(Filename)' == 'libSkiaSharp'" />
      <_ExcludedNativePublished Include="@(_PublishedNativeFiles)" Condition="'%(Filename)' == 'libHarfBuzzSharp'" />
      <_ExcludedNativePublished Include="@(_PublishedNativeFiles)" Condition="'%(Filename)' == 'av_libglesv2'" />
      <_ExcludedNativePublished Include="@(_PublishedNativeFiles)" Condition="'%(Filename)' == 'libAvaloniaNative'" />
    </ItemGroup>
    <Delete Files="@(_ExcludedPublished)" />
    <Delete Files="@(_ExcludedNativePublished)" />
    <Message Text="Cleaned shared dependencies from plugin publish output: $(PublishDir)" Importance="high" />
  </Target>

  <!--
    Generate shared-assemblies.txt: a plain-text list of assembly name patterns that the
    runtime PluginLoadContext should forward to the host's default AssemblyLoadContext.
    Each line is either an exact assembly name or a prefix pattern ending with '*'.

    This file is the runtime twin of the build-time exclusions above — both derive from the
    same properties, keeping build-time and runtime lists in sync by construction.
  -->
  <Target Name="GenerateSharedAssembliesList"
          AfterTargets="Build;Publish"
          DependsOnTargets="_ComputeSharedAssemblyFilters"
          Condition="'$(IsPluginProject)' == 'true' And '$(LYBoxPluginSharedExclusionsEnabled)' == 'true'">
    <WriteLinesToFile File="$(OutDir)shared-assemblies.txt" Lines="$(_SharedPatternsRaw)" Overwrite="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(PublishDir)shared-assemblies.txt" Condition="'$(PublishDir)' != '' And '$(PublishDir)' != '$(OutDir)'"
                      Lines="$(_SharedPatternsRaw)" Overwrite="true" Encoding="UTF-8" />
    <Message Text="Generated shared-assemblies.txt at: $(OutDir)shared-assemblies.txt" Importance="high" />
  </Target>

  <!--
    S1 清单 v2：GeneratePluginManifest 现在写入 kind 与 web 字段（schema v2）。
    kind 缺省为 Avalonia（向后兼容）；web 对象仅 kind=Web 时存在。
    校验见 ValidatePluginKind 目标。
  -->
  <PropertyGroup>
    <_PluginKind Condition="'$(PluginKind)' != ''">$(PluginKind)</_PluginKind>
    <_PluginKind Condition="'$(_PluginKind)' == ''">Avalonia</_PluginKind>
    <_WebBlock></_WebBlock>
    <_WebBlock Condition="'$(_PluginKind)' == 'Web'">,&#13;&#10;  "web": {&#13;&#10;    "wwwroot": "$(PluginWwwroot)",&#13;&#10;    "entryPage": "$(PluginEntryPage)"&#13;&#10;  }</_WebBlock>
    <!-- 插件自身数据 schema 版本（用于插件升级场景下的数据迁移提示）。-->
    <_SchemaBlock></_SchemaBlock>
    <_SchemaBlock Condition="'$(SchemaVersion)' != ''">,&#13;&#10;  "schemaVersion": "$(SchemaVersion)"</_SchemaBlock>
    <_SchemaBlock Condition="'$(SchemaVersion)' != '' And '$(RequiresDataMigration)' == 'true'">,&#13;&#10;  "schemaVersion": "$(SchemaVersion)",&#13;&#10;  "requiresDataMigration": true</_SchemaBlock>
    <_SchemaBlock Condition="'$(SchemaVersion)' == '' And '$(RequiresDataMigration)' == 'true'">,&#13;&#10;  "requiresDataMigration": true</_SchemaBlock>
  </PropertyGroup>

  <Target Name="ValidatePluginKind" AfterTargets="GeneratePluginManifest" Condition="'$(GeneratePluginManifest)' == 'true' And '$(IsPluginProject)' == 'true'">
    <Error Condition="'$(PluginKind)' == 'Web' And !Exists('$(PluginWwwroot)')" Text="LYBOX001: Web plugin '$(PluginId)' requires wwwroot directory at '$(PluginWwwroot)'" />
    <Error Condition="'$(PluginKind)' == 'Web' And !Exists('$(PluginWwwroot)\$(PluginEntryPage)')" Text="LYBOX002: Web plugin '$(PluginId)' entry page not found: '$(PluginWwwroot)\$(PluginEntryPage)'" />
    <Warning Condition="'$(PluginKind)' != 'Web' And Exists('wwwroot')" Text="LYBOX003: Non-Web plugin '$(PluginId)' has a wwwroot directory which will not be copied to output" />
  </Target>

  <Target Name="GeneratePluginManifest" AfterTargets="Build" Condition="'$(GeneratePluginManifest)' == 'true' And '$(IsPluginProject)' == 'true'">
    <PropertyGroup>
      <_PluginId Condition="'$(PluginId)' != ''">$(PluginId)</_PluginId>
      <_PluginId Condition="'$(PluginId)' == ''">$(AssemblyName)</_PluginId>
      <_PluginVersion Condition="'$(PackageVersion)' != ''">$(PackageVersion)</_PluginVersion>
      <_PluginVersion Condition="'$(PackageVersion)' == '' And '$(Version)' != ''">$(Version)</_PluginVersion>
      <_PluginVersion Condition="'$(_PluginVersion)' == ''">1.0.0</_PluginVersion>
      <_MinPluginSdkVersion Condition="'$(_MinPluginSdkVersion)' == ''">$(MinPluginSdkVersion)</_MinPluginSdkVersion>
      <_MinPluginSdkVersion Condition="'$(_MinPluginSdkVersion)' == ''">0.0.0</_MinPluginSdkVersion>
      <_PluginManifestContent>{&#13;&#10;  "pluginId": "$(_PluginId)",&#13;&#10;  "name": "$(PluginName)",&#13;&#10;  "version": "$(_PluginVersion)",&#13;&#10;  "author": "$(PluginAuthor)",&#13;&#10;  "description": "$(PluginDescription)",&#13;&#10;  "assembly": "$(AssemblyName).dll",&#13;&#10;  "dependencies": [],&#13;&#10;  "minPluginSdkVersion": "$(_MinPluginSdkVersion)",&#13;&#10;  "kind": "$(_PluginKind)"$(_WebBlock)$(_SchemaBlock)&#13;&#10;}</_PluginManifestContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(OutDir)plugin.json" Lines="$(_PluginManifestContent)" Overwrite="true" Encoding="UTF-8" />
    <Message Text="Generated plugin.json manifest at: $(OutDir)plugin.json (minPluginSdkVersion=$(_MinPluginSdkVersion), kind=$(_PluginKind), schemaVersion=$(SchemaVersion))" Importance="high" />
  </Target>
</Project>
