<Project>
    <!--
        仓库单一版本真相源：宿主（Launcher / UI / Platforms.*）与 SDK（Generators / Shared / Shared.Web）
        共用同一个版本号（HostVersion == PluginSdkVersion），在以下唯一文件中维护。

        插件版本不受此文件控制，由各插件 csproj 内 <PluginVersion> 独立管理（见 plugins/**/*.csproj）。

        版本来源优先级（高 → 低）：
          1. MSBuild 属性 /p:HostVersion=...   （build.cs 通过 -host-version 参数传入，CI 手动触发 / 紧急覆盖）
          2. 环境变量 LYBOX_HOST_VERSION        （CI/脚本注入）
          3. 下方 VersionFallback（本文件，唯一真相源，本地/IDE 构建兜底）

        发版流程：修改此文件中的 LyboxVersion → 提交 → 打标签 V<version> → push 触发 release-host.yml。
    -->
    <PropertyGroup>
        <LyboxVersion>2.3.0-preview.6</LyboxVersion>
    </PropertyGroup>
</Project>